    replacement_chunks {
      target_content: "  return (\n    <div className=\"flex flex-col gap-4 p-4 overflow-y-auto max-h-[calc(100vh-120px)] font-sans\">\n      {/* Header */}\n      <div>\n        <h2 className=\"font-display text-2xl font-extrabold text-[#211f19] tracking-tight\">\n          Sorting Rules & Taxonomy\n        </h2>\n        <p className=\"text-xs text-[#5c584c] mt-0.5\">\n          Define Source & Target folders, and train Ollama\'s sorting taxonomy with natural language category descriptions.\n        </p>\n      </div>\n\n      {/* Rule Folder Binding Header */}\n      {currentRule && (\n        <div className=\"bg-white border border-[#dcd8c9] rounded-xl p-3.5 shadow-sm flex items-center justify-between gap-4 font-mono text-xs\">\n          <div className=\"flex items-center gap-3\">\n            <FolderCheck className=\"w-5 h-5 text-[#177a4c]\" />\n            <div>\n              <span className=\"font-bold text-[#211f19]\">{currentRule.name}</span>\n              <div className=\"text-[10.5px] text-[#8b8676]\">\n                Source Watch: <b>{currentRule.sourceFolder}</b> \342\236\224 Target Shelf: <b>{currentRule.targetFolder}</b>\n              </div>\n            </div>\n          </div>\n          <span className=\"font-bold text-[10px] bg-[#dcefe2] text-[#0e5c38] px-2.5 py-1 rounded-full uppercase\">\n            Active Rule\n          </span>\n        </div>\n      )}\n\n      {/* Main Grid: Categories List + Prompt Template Editor */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-4\">\n        {/* Category List Editor */}\n        <div className=\"lg:col-span-2 space-y-3\">\n          <div className=\"flex items-center justify-between\">\n            <h3 className=\"font-bold text-xs uppercase tracking-wider text-[#5c584c]\">\n              Taxonomy Categories ({categories.length})\n            </h3>\n            <div className=\"flex gap-2\">\n              <button\n                onClick={handleAddCategory}\n                className=\"bg-[#177a4c] hover:bg-[#0e5c38] text-white font-bold text-xs py-1.5 px-3 rounded-lg transition-all flex items-center gap-1.5 shadow-sm\"\n              >\n                <Plus className=\"w-3.5 h-3.5\" />\n                <span>Add Category</span>\n              </button>\n              <button\n                onClick={onResetRules}\n                className=\"bg-white hover:bg-[#efede4] text-[#5c584c] border border-[#cbc6b4] font-bold text-xs py-1.5 px-3 rounded-lg transition-all flex items-center gap-1.5\"\n              >\n                <RotateCcw className=\"w-3.5 h-3.5\" />\n                <span>Reset Defaults</span>\n              </button>\n            </div>\n          </div>\n\n          <div className=\"space-y-2\">\n            {categories.map((c) => (\n              <div\n                key={c.id}\n                className=\"bg-white border border-[#dcd8c9] hover:border-[#cbc6b4] rounded-xl p-3 shadow-sm grid grid-cols-12 gap-2 items-center\"\n              >\n                {/* Color Picker */}\n                <div className=\"col-span-1 flex justify-center\">\n                  <input\n                    type=\"color\"\n                    value={c.color}\n                    onChange={(e) => handleCategoryChange(c.id, \'color\', e.target.value)}\n                    className=\"w-7 h-7 rounded-lg border-0 cursor-pointer bg-transparent\"\n                    title=\"Category Color\"\n                  />\n                </div>\n\n                {/* Name */}\n                <div className=\"col-span-3\">\n                  <input\n                    type=\"text\"\n                    value={c.name}\n                    onChange={(e) => handleCategoryChange(c.id, \'name\', e.target.value)}\n                    className=\"w-full font-display font-bold text-xs bg-[#efede4] focus:bg-white border border-transparent focus:border-[#177a4c] focus:outline-none rounded-lg px-2 py-1.5 text-[#211f19]\"\n                    placeholder=\"Category Name\"\n                  />\n                </div>\n\n                {/* Description for AI */}\n                <div className=\"col-span-4\">\n                  <input\n                    type=\"text\"\n                    value={c.desc}\n                    onChange={(e) => handleCategoryChange(c.id, \'desc\', e.target.value)}\n                    className=\"w-full font-sans text-xs bg-[#efede4] focus:bg-white border border-transparent focus:border-[#177a4c] focus:outline-none rounded-lg px-2 py-1.5 text-[#211f19]\"\n                    placeholder=\"AI Prompt Description...\"\n                  />\n                </div>\n\n                {/* Extensions */}\n                <div className=\"col-span-3\">\n                  <input\n                    type=\"text\"\n                    value={c.exts}\n                    onChange={(e) => handleCategoryChange(c.id, \'exts\', e.target.value)}\n                    className=\"w-full font-mono text-[11px] bg-[#efede4] focus:bg-white border border-transparent focus:border-[#177a4c] focus:outline-none rounded-lg px-2 py-1.5 text-[#5c584c]\"\n                    placeholder=\"ext1, ext2\"\n                  />\n                </div>\n\n                {/* Delete button */}\n                <div className=\"col-span-1 flex justify-end\">\n                  {c.id !== \'misc\' && (\n                    <button\n                      onClick={() => handleDeleteCategory(c.id)}\n                      className=\"p-1.5 text-[#8b8676] hover:text-rose-600 rounded-lg hover:bg-rose-50 transition-colors\"\n                      title=\"Delete Category\"\n                    >\n                      <Trash2 className=\"w-4 h-4\" />\n                    </button>\n                  )}\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* System Prompt Template Box */}\n        <div className=\"bg-white border border-[#dcd8c9] rounded-xl p-4 shadow-sm flex flex-col gap-3\