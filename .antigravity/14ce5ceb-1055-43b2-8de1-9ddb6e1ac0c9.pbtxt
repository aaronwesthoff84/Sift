    instruction: "Apply Frosted Glass theme to TopBar component"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <header className=\"flex-none flex flex-col bg-[#efede4] border-b border-[#dcd8c9] select-none\">\n      {/* Titlebar with native platform window controls */}\n      <div className=\"h-10 flex items-center justify-between px-4 bg-gradient-to-b from-[#f4f2ea] to-[#e9e6da] border-b border-[#dcd8c9] relative\">\n        {/* Left window controls based on active OS platform */}\n        <div className=\"flex items-center gap-3\">\n          {platform === \'macos\' && (\n            <div className=\"flex items-center gap-2\">\n              <span className=\"w-3 h-3 rounded-full bg-[#ff5f57] border border-black/20 shadow-inner flex items-center justify-center text-[8px] font-bold text-black/40 hover:after:content-[\'\303\227\'] cursor-pointer\" title=\"Close\" />\n              <span className=\"w-3 h-3 rounded-full bg-[#febc2e] border border-black/20 shadow-inner flex items-center justify-center text-[8px] font-bold text-black/40 hover:after:content-[\'\342\200\223\'] cursor-pointer\" title=\"Minimize\" />\n              <span className=\"w-3 h-3 rounded-full bg-[#28c840] border border-black/20 shadow-inner flex items-center justify-center text-[8px] font-bold text-black/40 hover:after:content-[\'+\'] cursor-pointer\" title=\"Maximize\" />\n            </div>\n          )}\n\n          {platform === \'windows\' && (\n            <div className=\"flex items-center gap-1.5 text-[10px] font-mono font-semibold text-[#8b8676] bg-[#e7e4d8] px-2 py-0.5 rounded\">\n              <Monitor className=\"w-3 h-3 text-[#177a4c]\" />\n              <span>Windows AppData</span>\n            </div>\n          )}\n\n          {platform === \'linux\' && (\n            <div className=\"flex items-center gap-1.5 text-[10px] font-mono font-semibold text-[#8b8676] bg-[#e7e4d8] px-2 py-0.5 rounded\">\n              <ShieldCheck className=\"w-3 h-3 text-[#33719f]\" />\n              <span>Linux XDG Config</span>\n            </div>\n          )}\n\n          {/* Platform Switcher */}\n          <div className=\"flex items-center gap-1 bg-[#e7e4d8] p-0.5 rounded-md border border-[#cbc6b4] text-[10px] font-mono ml-2\">\n            <button\n              onClick={() => setPlatform(\'macos\')}\n              className={`px-1.5 py-0.5 rounded transition-all ${platform === \'macos\' ? \'bg-white font-bold text-[#177a4c] shadow-sm\' : \'text-[#5c584c] hover:text-black\'}`}\n              title=\"macOS Native View\"\n            >\n              macOS\n            </button>\n            <button\n              onClick={() => setPlatform(\'windows\')}\n              className={`px-1.5 py-0.5 rounded transition-all ${platform === \'windows\' ? \'bg-white font-bold text-[#177a4c] shadow-sm\' : \'text-[#5c584c] hover:text-black\'}`}\n              title=\"Windows Native View\"\n            >\n              Win\n            </button>\n            <button\n              onClick={() => setPlatform(\'linux\')}\n              className={`px-1.5 py-0.5 rounded transition-all ${platform === \'linux\' ? \'bg-white font-bold text-[#177a4c] shadow-sm\' : \'text-[#5c584c] hover:text-black\'}`}\n              title=\"Linux Native View\"\n            >\n              Linux\n            </button>\n          </div>\n        </div>\n\n        {/* Center Title */}\n        <div className=\"absolute left-1/2 -translate-x-1/2 flex items-center gap-2 font-display font-bold text-sm tracking-tight text-[#211f19]\">\n          <span className=\"w-4 h-4 rounded-md bg-gradient-to-br from-[#177a4c] to-[#0c4a2c] flex items-center justify-center text-white text-[10px] shadow-sm\">\n            \342\227\206\n          </span>\n          <span>Sift</span>\n          <span className=\"font-mono text-[10px] font-medium text-[#8b8676] bg-[#e7e4d8] px-1.5 py-0.5 rounded border border-[#cbc6b4]\">\n            v1.2.0\n          </span>\n        </div>\n\n        {/* Right Status */}\n        <div className=\"flex items-center gap-3 text-xs font-mono text-[#8b8676]\">\n          {hasGeminiKey && (\n            <span className=\"inline-flex items-center gap-1 text-[10px] bg-[#dcefe2] text-[#0e5c38] px-2 py-0.5 rounded-full font-bold\">\n              <Sparkles className=\"w-2.5 h-2.5\" /> Gemini Ready\n            </span>\n          )}\n          <span>folder autopilot \302\267 ollama</span>\n        </div>\n      </div>\n\n      {/* Main Control Toolbar */}\n      <div className=\"flex items-center justify-between gap-3 p-2.5 px-4 bg-[#f6f4ee]\">\n        {/* Watch Control Button */}\n        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={onToggleWatch}\n            className={`flex items-center gap-2 text-xs font-semibold px-3 py-1.5 rounded-lg border transition-all shadow-sm ${\n              watching\n                ? \'bg-[#177a4c] border-[#0e5c38] text-white shadow-[#177a4c]/20\'\n                : \'bg-white border-[#cbc6b4] text-[#211f19] hover:border-[#177a4c]\'\n            }`}\n          >\n            <span className={`w-3 h-3 rounded-full border-2 flex items-center justify-center ${watching ? \'border-white animate-pulse bg-emerald-400\' : \'border-gray-400\'}`} />\n            {watching ? \'Watching (Active)\' : \'Start Watching\'}\n          </button>\n\n          {/* Watched Path Pill */}\n          <button\n            onClick={onEditPath}\n            className=\"flex items-center gap-2 bg-white border border-[#dcd8c9] hover:border-[#177a4c] rounded-lg px-3 py-1.5 text-xs transition-colors max-w-[280px] group\"\n            title=\"Click to edit watch folder\"\n          >\n            <span className=\"text-[#c08427]\">\360\237\223\201</span>\n            <span className=\"font-mono text-[11px] truncate text-[#211f19] font-medium\">{watchPath}</span>\n            <span className=\"text-[9px] font-bold uppercase tracking-wider text-[#8b8676] group-hover:text-[#177a4c]\">edit</span>\n          </button>\n        </div>\n\n        {/* Right Action Tools */}\n        <div className=\"flex items-center gap-2.5\">\n          {/* Model Selector Dropdown */}\n          <div className=\"flex items-center gap-1.5\">\n            <Cpu className=\"w-3.5 h-3.5 text-[#5c584c]\" />\n            <select\n              value={selectedModel}\n              onChange={(e) => onSelectModel(e.target.value)}\n              className=\"font-mono text-xs font-semibold bg-white text-[#211f19] border border-[#cbc6b4] rounded-lg px-2.5 py-1.5 focus:outline-none focus:border-[#177a4c] cursor-pointer hover:border-[#177a4c]\"\n            >\n              {models.map((m) => (\n                <option key={m} value={m}>\n                  {m}\n                </option>\n              ))}\n            </select>\n          </div>\n\n          {/* Mode Toggle (Auto-sort / Review) */}\n          <div className=\"flex bg-[#e7e4d8] p-0.5 rounded-lg border border-[#cbc6b4] text-xs font-semibold\">\n            <button\n              onClick={() => onSetMode(\'auto\')}\n              className={`px-3 py-1 rounded-md transition-all ${\n                mode === \'auto\'\n                  ? \'bg-white text-[#211f19] shadow-sm font-bold\'\n                  : \'text-[#5c584c] hover:text-black\'\n              }`}\n            >\n              Auto-sort\n            </button>\n            <button\n              onClick={() => onSetMode(\'review\')}\n              className={`px-3 py-1 rounded-md transition-all ${\n                mode === \'review\'\n                  ? \'bg-white text-[#211f19] shadow-sm font-bold\'\n                  : \'text-[#5c584c] hover:text-black\'\n              }`}\n            >\n              Review\n            </button>\n          </div>\n\n          {/* Action Buttons: Add File & Simulate */}\n          <button\n            onClick={onUploadClick}\n            className=\"flex items-center gap-1.5 font-semibold text-xs bg-white text-[#211f19] border border-[#cbc6b4] hover:border-[#177a4c] rounded-lg px-3 py-1.5 transition-all shadow-sm\"\n            title=\"Upload actual files to the watch folder\"\n          >\n            <Upload className=\"w-3.5 h-3.5 text-[#177a4c]\" />\n            <span>Drop Files</span>\n          </button>\n\n          <button\n            onClick={onSimulate}\n            className=\"flex items-center gap-1.5 font-semibold text-xs bg-[#211f19] hover:bg-black text-[#f6f4ee] rounded-lg px-3 py-1.5 transition-all shadow-sm\"\n            title=\"Simulate a file arrival\"\n          >\n            <Plus className=\"w-3.5 h-3.5 text-emerald-400\" />\n            <span>Simulate File</span>\n          </button>\n        </div>\n      </div>\n    </header>\n  );"
        replacement_content: "  return (\n    <header className=\"flex-none flex flex-col bg-black/40 backdrop-blur-md border-b border-white/10 select-none text-slate-200\">\n      {/* Titlebar with native platform window controls */}\n      <div className=\"h-10 flex items-center justify-between px-4 bg-black/50 border-b border-white/5 relative\">\n        {/* Left window controls based on active OS platform */}\n        <div className=\"flex items-center gap-3\">\n          {platform === \'macos\' && (\n            <div className=\"flex items-center gap-2\">\n              <span className=\"w-3 h-3 rounded-full bg-rose-500/80 hover:bg-rose-500 transition-colors cursor-pointer\" title=\"Close\" />\n              <span className=\"w-3 h-3 rounded-full bg-amber-500/80 hover:bg-amber-500 transition-colors cursor-pointer\" title=\"Minimize\" />\n              <span className=\"w-3 h-3 rounded-full bg-emerald-500/80 hover:bg-emerald-500 transition-colors cursor-pointer\" title=\"Maximize\" />\n            </div>\n          )}\n\n          {platform === \'windows\' && (\n            <div className=\"flex items-center gap-1.5 text-[10px] font-mono font-semibold text-slate-400 bg-white/5 px-2 py-0.5 rounded border border-white/10\">\n              <Monitor className=\"w-3 h-3 text-emerald-400\" />\n              <span>Windows AppData</span>\n            </div>\n          )}\n\n          {platform === \'linux\' && (\n            <div className=\"flex items-center gap-1.5 text-[10px] font-mono font-semibold text-slate-400 bg-white/5 px-2 py-0.5 rounded border border-white/10\">\n              <ShieldCheck className=\"w-3 h-3 text-indigo-400\" />\n              <span>Linux XDG Config</span>\n            </div>\n          )}\n\n          {/* Platform Switcher */}\n          <div className=\"flex items-center gap-1 bg-white/5 p-0.5 rounded-md border border-white/10 text-[10px] font-mono ml-2\">\n            <button\n              onClick={() => setPlatform(\'macos\')}\n              className={`px-1.5 py-0.5 rounded transition-all ${platform === \'macos\' ? \'bg-indigo-500/20 text-indigo-300 font-bold border border-indigo-500/30\' : \'text-slate-400 hover:text-white\'}`}\n              title=\"macOS Native View\"\n            >\n              macOS\n            </button>\n            <button\n              onClick={() => setPlatform(\'windows\')}\n              className={`px-1.5 py-0.5 rounded transition-all ${platform === \'windows\' ? \'bg-indigo-500/20 text-indigo-300 font-bold border border-indigo-500/30\' : \'text-slate-400 hover:text-white\'}`}\n              title=\"Windows Native View\"\n            >\n              Win\n            </button>\n            <button\n              onClick={() => setPlatform(\'linux\')}\n              className={`px-1.5 py-0.5 rounded transition-all ${platform === \'linux\' ? \'bg-indigo-500/20 text-indigo-300 font-bold border border-indigo-500/30\' : \'text-slate-400 hover:text-white\'}`}\n              title=\"Linux Native View\"\n            >\n              Linux\n            </button>\n          </div>\n        </div>\n\n        {/* Center Title */}\n        <div className=\"absolute left-1/2 -translate-x-1/2 flex items-center gap-2 font-display font-bold text-sm tracking-tight text-white\">\n          <span className=\"w-4 h-4 rounded-md bg-indigo-500/20 text-indigo-400 border border-indigo-500/30 flex items-center justify-center text-[10px] shadow-sm\">\n            \342\227\206\n          </span>\n          <span className=\"tracking-tight\">SIFT.AI</span>\n          <span className=\"font-mono text-[10px] font-medium text-slate-400 bg-white/5 px-1.5 py-0.5 rounded border border-white/10\">\n            v1.2.0\n          </span>\n        </div>\n\n        {/* Right Status */}\n        <div className=\"flex items-center gap-3 text-xs font-mono text-slate-400\">\n          {hasGeminiKey && (\n            <span className=\"inline-flex items-center gap-1 text-[10px] bg-indigo-500/20 text-indigo-300 px-2.5 py-0.5 rounded-full font-bold border border-indigo-500/30\">\n              <Sparkles className=\"w-2.5 h-2.5\" /> Gemini Ready\n            </span>\n          )}\n          <span>folder autopilot \302\267 ollama</span>\n        </div>\n      </div>\n\n      {/* Main Control Toolbar */}\n      <div className=\"flex items-center justify-between gap-3 p-2.5 px-4 bg-black/20\">\n        {/* Watch Control Button */}\n        <div className=\"flex items-center gap-2\">\n          <button\n            onClick={onToggleWatch}\n            className={`flex items-center gap-2 text-xs font-semibold px-3 py-1.5 rounded-xl border transition-all shadow-sm ${\n              watching\n                ? \'bg-indigo-600 border-indigo-500/50 text-white shadow-indigo-500/20\'\n                : \'bg-white/5 border-white/10 text-slate-300 hover:bg-white/10\'\n            }`}\n          >\n            <span className={`w-2.5 h-2.5 rounded-full ${watching ? \'bg-emerald-400 animate-pulse\' : \'bg-slate-500\'}`} />\n            {watching ? \'Watching (Active)\' : \'Start Watching\'}\n          </button>\n\n          {/* Watched Path Pill */}\n          <button\n            onClick={onEditPath}\n            className=\"flex items-center gap-2 bg-white/5 border border-white/10 hover:border-indigo-500/50 rounded-xl px-3 py-1.5 text-xs transition-all max-w-[280px] group\"\n            title=\"Click to edit watch folder\"\n          >\n            <span className=\"text-amber-400\">\360\237\223\201</span>\n            <span className=\"font-mono text-[11px] truncate text-slate-200 font-medium\">{watchPath}</span>\n            <span className=\"text-[9px] font-bold uppercase tracking-wider text-slate-500 group-hover:text-indigo-400\">edit</span>\n          </button>\n        </div>\n\n        {/* Right Action Tools */}\n        <div className=\"flex items-center gap-2.5\">\n          {/* Model Selector Dropdown */}\n          <div className=\"flex items-center gap-1.5 bg-white/5 border border-white/10 rounded-xl px-2.5 py-1\">\n            <Cpu className=\"w-3.5 h-3.5 text-indigo-400\" />\n            <select\n              value={selectedModel}\n              onChange={(e) => onSelectModel(e.target.value)}\n              className=\"font-mono text-xs font-semibold bg-transparent text-white focus:outline-none cursor-pointer\"\n            >\n              {models.map((m) => (\n                <option key={m} value={m} className=\"bg-[#0c0d0e] text-white\">\n                  {m}\n                </option>\n              ))}\n            </select>\n          </div>\n\n          {/* Mode Toggle (Auto-sort / Review) */}\n          <div className=\"flex bg-white/5 p-0.5 rounded-xl border border-white/10 text-xs font-semibold\">\n            <button\n              onClick={() => onSetMode(\'auto\')}\n              className={`px-3 py-1 rounded-lg transition-all ${\n                mode === \'auto\'\n                  ? \'bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 font-bold\'\n                  : \'text-slate-400 hover:text-white\'\n              }`}\n            >\n              Auto-sort\n            </button>\n            <button\n              onClick={() => onSetMode(\'review\')}\n              className={`px-3 py-1 rounded-lg transition-all ${\n                mode === \'review\'\n                  ? \'bg-indigo-500/20 text-indigo-300 border border-indigo-500/30 font-bold\'\n                  : \'text-slate-400 hover:text-white\'\n              }`}\n            >\n              Review\n            </button>\n          </div>\n\n          {/* Action Buttons: Add File & Simulate */}\n          <button\n            onClick={onUploadClick}\n            className=\"flex items-center gap-1.5 font-semibold text-xs bg-white/10 hover:bg-white/15 text-white border border-white/10 rounded-xl px-3 py-1.5 transition-all shadow-sm\"\n            title=\"Upload actual files to the watch folder\"\n          >\n            <Upload className=\"w-3.5 h-3.5 text-indigo-400\" />\n            <span>Drop Files</span>\n          </button>\n\n          <button\n            onClick={onSimulate}\n            className=\"flex items-center gap-1.5 font-semibold text-xs bg-indigo-600 hover:bg-indigo-500 text-white border border-indigo-500/30 rounded-xl px-3 py-1.5 transition-all shadow-lg shadow-indigo-600/20\"\n            title=\"Simulate a file arrival\"\n          >\n            <Plus className=\"w-3.5 h-3.5 text-white\" />\n            <span>Simulate File</span>\n          </button>\n        </div>\n      </div>\n    </header>\n  );"
