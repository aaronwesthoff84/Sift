    instruction: "Apply Frosted Glass theme to ShelfView component"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"flex flex-col gap-4 p-4 overflow-y-auto max-h-[calc(100vh-120px)] font-sans\">\n      {/* Header */}\n      <div className=\"flex items-baseline justify-between\">\n        <div>\n          <h2 className=\"font-display text-2xl font-extrabold text-[#211f19] tracking-tight\">\n            The Target Shelf\n          </h2>\n          <p className=\"text-xs text-[#5c584c] mt-0.5\">\n            Target folders and subfolders. Click a folder to inspect sorted files or reverse any move.\n          </p>\n        </div>\n\n        {/* Search Input */}\n        <div className=\"relative w-64\">\n          <Search className=\"w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-[#8b8676]\" />\n          <input\n            type=\"text\"\n            placeholder=\"Search files in shelf\342\200\246\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            className=\"w-full font-mono text-xs bg-white border border-[#cbc6b4] focus:border-[#177a4c] focus:outline-none rounded-lg pl-8 pr-3 py-1.5 text-[#211f19]\"\n          />\n        </div>\n      </div>\n\n      {/* Target Folders Grid */}\n      <div className=\"grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3\">\n        {categories.map((c) => {\n          const fileList = shelfData[c.id] || [];\n          const count = fileList.length;\n          const isSelected = selectedCatId === c.id;\n\n          return (\n            <button\n              key={c.id}\n              onClick={() => onSelectCategory(c.id)}\n              className={`border bg-white rounded-xl p-3 flex flex-col justify-between items-start text-left relative overflow-hidden transition-all group ${\n                isSelected\n                  ? \'border-2 shadow-md scale-[1.02]\'\n                  : \'border-[#dcd8c9] hover:border-[#177a4c] hover:-translate-y-0.5 shadow-sm\'\n              }`}\n              style={{\n                borderColor: isSelected ? c.color : undefined,\n                boxShadow: isSelected ? `0 0 0 3px ${c.color}20` : undefined,\n              }}\n            >\n              <div\n                className=\"absolute inset-0 opacity-10 pointer-events-none\"\n                style={{ backgroundColor: c.color }}\n              />\n\n              <div className=\"flex items-center justify-between w-full\">\n                <Folder\n                  className=\"w-7 h-7\"\n                  style={{ color: c.color, fill: `${c.color}30` }}\n                />\n                <span\n                  className=\"font-mono font-bold text-xs px-2 py-0.5 rounded-md\"\n                  style={{\n                    backgroundColor: `${c.color}18`,\n                    color: c.color,\n                  }}\n                >\n                  {count}\n                </span>\n              </div>\n\n              <div className=\"mt-3\">\n                <div className=\"font-display font-bold text-xs truncate text-[#211f19]\">\n                  {c.name}\n                </div>\n                <div className=\"font-mono text-[9.5px] text-[#8b8676] truncate mt-0.5\">\n                  /{c.targetSubfolder || c.name}\n                </div>\n              </div>\n            </button>\n          );\n        })}\n      </div>\n\n      {/* Selected Subfolder Table */}\n      <div className=\"bg-white border border-[#dcd8c9] rounded-xl overflow-hidden shadow-sm\">\n        <div className=\"flex items-center justify-between p-3 px-4 border-b border-[#dcd8c9] bg-gradient-to-b from-white to-[#faf9f4]\">\n          <div className=\"flex items-center gap-2.5\">\n            <span\n              className=\"w-2.5 h-2.5 rounded-full\"\n              style={{ backgroundColor: selectedCat.color }}\n            />\n            <h3 className=\"font-display font-bold text-base text-[#211f19]\">\n              {selectedCat.name} Subfolder\n            </h3>\n            <span className=\"font-mono text-xs text-[#8b8676]\">\n              ({filteredItems.length} file{filteredItems.length === 1 ? \'\' : \'s\'})\n            </span>\n          </div>\n\n          <div className=\"flex items-center gap-2 font-mono text-xs text-[#8b8676]\">\n            <span>Path: {shelfDirPath}/{selectedCat.targetSubfolder || selectedCat.name}</span>\n          </div>\n        </div>\n\n        {filteredItems.length === 0 ? (\n          <div className=\"p-8 text-center text-[#8b8676] text-xs\">\n            No files in this category yet. The watcher will file matching items here automatically.\n          </div>\n        ) : (\n          <div className=\"divide-y divide-[#f4f2ea]\">\n            {filteredItems.map((f, idx) => (\n              <div\n                key={idx}\n                className=\"grid grid-cols-12 items-center gap-2 p-2.5 px-4 text-xs font-mono hover:bg-[#efede4]/50 transition-colors\"\n              >\n                <div className=\"col-span-5 flex items-center gap-2.5 min-w-0\">\n                  <FileText className=\"w-4 h-4 text-[#8b8676] flex-none\" />\n                  <span className=\"font-semibold truncate text-[#211f19]\" title={f.name}>\n                    {f.name}\n                  </span>\n                </div>\n\n                <div className=\"col-span-2 text-[#8b8676]\">{fmtSize(f.size)}</div>\n\n                <div className=\"col-span-2\">\n                  <span\n                    className={`font-bold text-[10px] px-2 py-0.5 rounded-full ${\n                      f.engine === \'ollama\'\n                        ? \'bg-[#dcefe2] text-[#0e5c38]\'\n                        : f.engine === \'gemini\'\n                        ? \'bg-sky-100 text-[#33719f]\'\n                        : \'bg-[#f4e7cd] text-[#8a5d13]\'\n                    }`}\n                  >\n                    {f.engine || \'ollama\'}\n                  </span>\n                </div>\n\n                <div className=\"col-span-2 text-[#8b8676]\">\n                  {f.conf ? `${Math.round(f.conf * 100)}% conf` : \'100%\'}\n                </div>\n\n                <div className=\"col-span-1 flex items-center justify-end gap-1\">\n                  <button\n                    onClick={() => setPreviewFile(f)}\n                    className=\"p-1 rounded hover:bg-[#dcd8c9] text-[#5c584c] transition-colors\"\n                    title=\"Preview File\"\n                  >\n                    <Eye className=\"w-3.5 h-3.5\" />\n                  </button>\n\n                  <button\n                    onClick={() => onUndoSortFile(f.name, selectedCat.id)}\n                    className=\"p-1 rounded hover:bg-rose-100 text-rose-700 transition-colors\"\n                    title=\"Undo Move (Restore to Watch folder)\"\n                  >\n                    <Undo2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              </div>\n            ))}\n          </div>\n        )}\n      </div>\n\n      {/* File Preview Modal */}\n      {previewFile && (\n        <div className=\"fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-white border border-[#dcd8c9] rounded-2xl p-5 max-w-lg w-full shadow-2xl flex flex-col gap-3\">\n            <div className=\"flex justify-between items-center pb-2 border-b border-[#dcd8c9]\">\n              <div className=\"flex items-center gap-2 font-mono font-bold text-sm text-[#211f19]\">\n                <FileText className=\"w-4 h-4 text-[#177a4c]\" />\n                <span className=\"truncate max-w-[320px]\">{previewFile.name}</span>\n              </div>\n              <button\n                onClick={() => setPreviewFile(null)}\n                className=\"text-xs font-bold text-[#8b8676] hover:text-black\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            <div className=\"space-y-1.5 text-xs font-mono text-[#5c584c] bg-[#efede4] p-3 rounded-xl border border-[#cbc6b4]\">\n              <div>Size: <b>{fmtSize(previewFile.size)}</b></div>\n              <div>Subfolder: <b>{selectedCat.targetSubfolder || selectedCat.name}</b></div>\n              <div>Sorting Engine: <b>{previewFile.engine || \'ollama\'}</b></div>\n              <div>Confidence: <b>{previewFile.conf ? `${Math.round(previewFile.conf * 100)}%` : \'95%\'}</b></div>\n            </div>\n\n            <div className=\"flex justify-end gap-2 mt-2\">\n              <button\n                onClick={() => {\n                  onUndoSortFile(previewFile.name, selectedCat.id);\n                  setPreviewFile(null);\n                }}\n                className=\"bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs py-1.5 px-3 rounded-lg transition-all flex items-center gap-1.5\"\n              >\n                <Undo2 className=\"w-3.5 h-3.5\" />\n                <span>Undo & Restore File</span>\n              </button>\n              <button\n                onClick={() => setPreviewFile(null)}\n                className=\"bg-[#211f19] text-white font-bold text-xs py-1.5 px-4 rounded-lg\"\n              >\n                Close\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );"
        replacement_content: "  return (\n    <div className=\"flex flex-col gap-5 p-6 overflow-y-auto max-h-[calc(100vh-120px)] font-sans text-slate-200\">\n      {/* Header */}\n      <div className=\"flex items-baseline justify-between\">\n        <div>\n          <h2 className=\"text-3xl font-light tracking-tight text-white mb-1\">\n            The Target Shelf\n          </h2>\n          <p className=\"text-xs text-slate-400\">\n            Target folders and subfolders. Click a folder to inspect sorted files or reverse any move.\n          </p>\n        </div>\n\n        {/* Search Input */}\n        <div className=\"relative w-64\">\n          <Search className=\"w-3.5 h-3.5 absolute left-3 top-1/2 -translate-y-1/2 text-slate-500\" />\n          <input\n            type=\"text\"\n            placeholder=\"Search files in shelf\342\200\246\"\n            value={searchTerm}\n            onChange={(e) => setSearchTerm(e.target.value)}\n            className=\"w-full font-mono text-xs bg-white/5 border border-white/10 focus:border-indigo-500/50 focus:bg-white/10 focus:outline-none rounded-xl pl-8 pr-3 py-2 text-white placeholder-slate-500\"\n          />\n        </div>\n      </div>\n\n      {/* Target Folders Grid */}\n      <div className=\"grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3.5\">\n        {categories.map((c) => {\n          const fileList = shelfData[c.id] || [];\n          const count = fileList.length;\n          const isSelected = selectedCatId === c.id;\n\n          return (\n            <button\n              key={c.id}\n              onClick={() => onSelectCategory(c.id)}\n              className={`border bg-white/5 rounded-2xl p-3.5 flex flex-col justify-between items-start text-left relative overflow-hidden transition-all group backdrop-blur-sm ${\n                isSelected\n                  ? \'border-2 shadow-xl scale-[1.02] bg-white/10\'\n                  : \'border-white/10 hover:border-white/20 hover:bg-white/10 shadow-sm\'\n              }`}\n              style={{\n                borderColor: isSelected ? c.color : undefined,\n                boxShadow: isSelected ? `0 0 20px -5px ${c.color}40` : undefined,\n              }}\n            >\n              <div\n                className=\"absolute inset-0 opacity-10 pointer-events-none\"\n                style={{ backgroundColor: c.color }}\n              />\n\n              <div className=\"flex items-center justify-between w-full\">\n                <Folder\n                  className=\"w-7 h-7\"\n                  style={{ color: c.color, fill: `${c.color}40` }}\n                />\n                <span\n                  className=\"font-mono font-bold text-xs px-2 py-0.5 rounded-md border\"\n                  style={{\n                    backgroundColor: `${c.color}20`,\n                    borderColor: `${c.color}40`,\n                    color: c.color,\n                  }}\n                >\n                  {count}\n                </span>\n              </div>\n\n              <div className=\"mt-3\">\n                <div className=\"font-display font-semibold text-xs truncate text-white\">\n                  {c.name}\n                </div>\n                <div className=\"font-mono text-[9.5px] text-slate-400 truncate mt-0.5\">\n                  /{c.targetSubfolder || c.name}\n                </div>\n              </div>\n            </button>\n          );\n        })}\n      </div>\n\n      {/* Selected Subfolder Table */}\n      <div className=\"bg-white/5 border border-white/10 rounded-2xl overflow-hidden shadow-lg backdrop-blur-sm\">\n        <div className=\"flex items-center justify-between p-4 px-5 border-b border-white/10 bg-black/20\">\n          <div className=\"flex items-center gap-2.5\">\n            <span\n              className=\"w-3 h-3 rounded-full\"\n              style={{ backgroundColor: selectedCat.color }}\n            />\n            <h3 className=\"font-display font-bold text-base text-white\">\n              {selectedCat.name} Subfolder\n            </h3>\n            <span className=\"font-mono text-xs text-slate-400\">\n              ({filteredItems.length} file{filteredItems.length === 1 ? \'\' : \'s\'})\n            </span>\n          </div>\n\n          <div className=\"flex items-center gap-2 font-mono text-xs text-slate-400\">\n            <span>Path: <code className=\"text-slate-300\">{shelfDirPath}/{selectedCat.targetSubfolder || selectedCat.name}</code></span>\n          </div>\n        </div>\n\n        {filteredItems.length === 0 ? (\n          <div className=\"p-12 text-center text-slate-400 text-xs\">\n            No files in this category yet. The watcher will file matching items here automatically.\n          </div>\n        ) : (\n          <div className=\"divide-y divide-white/5\">\n            {filteredItems.map((f, idx) => (\n              <div\n                key={idx}\n                className=\"grid grid-cols-12 items-center gap-2 p-3 px-5 text-xs font-mono hover:bg-white/5 transition-colors\"\n              >\n                <div className=\"col-span-5 flex items-center gap-2.5 min-w-0\">\n                  <FileText className=\"w-4 h-4 text-slate-400 flex-none\" />\n                  <span className=\"font-semibold truncate text-slate-200\" title={f.name}>\n                    {f.name}\n                  </span>\n                </div>\n\n                <div className=\"col-span-2 text-slate-400\">{fmtSize(f.size)}</div>\n\n                <div className=\"col-span-2\">\n                  <span\n                    className={`font-bold text-[10px] px-2.5 py-0.5 rounded-full border ${\n                      f.engine === \'ollama\'\n                        ? \'bg-emerald-500/20 text-emerald-300 border-emerald-500/30\'\n                        : f.engine === \'gemini\'\n                        ? \'bg-indigo-500/20 text-indigo-300 border-indigo-500/30\'\n                        : \'bg-amber-500/20 text-amber-300 border-amber-500/30\'\n                    }`}\n                  >\n                    {f.engine || \'ollama\'}\n                  </span>\n                </div>\n\n                <div className=\"col-span-2 text-slate-400\">\n                  {f.conf ? `${Math.round(f.conf * 100)}% conf` : \'100%\'}\n                </div>\n\n                <div className=\"col-span-1 flex items-center justify-end gap-1\">\n                  <button\n                    onClick={() => setPreviewFile(f)}\n                    className=\"p-1.5 rounded-lg hover:bg-white/10 text-slate-400 hover:text-white transition-colors\"\n                    title=\"Preview File\"\n                  >\n                    <Eye className=\"w-3.5 h-3.5\" />\n                  </button>\n\n                  <button\n                    onClick={() => onUndoSortFile(f.name, selectedCat.id)}\n                    className=\"p-1.5 rounded-lg hover:bg-rose-500/20 text-rose-400 hover:text-rose-300 transition-colors\"\n                    title=\"Undo Move (Restore to Watch folder)\"\n                  >\n                    <Undo2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              </div>\n            ))}\n          </div>\n        )}\n      </div>\n\n      {/* File Preview Modal */}\n      {previewFile && (\n        <div className=\"fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4\">\n          <div className=\"bg-[#0c0d0e]/95 border border-white/10 rounded-2xl p-6 max-w-lg w-full shadow-2xl flex flex-col gap-4 text-slate-200\">\n            <div className=\"flex justify-between items-center pb-3 border-b border-white/10\">\n              <div className=\"flex items-center gap-2 font-mono font-bold text-sm text-white\">\n                <FileText className=\"w-4 h-4 text-indigo-400\" />\n                <span className=\"truncate max-w-[320px]\">{previewFile.name}</span>\n              </div>\n              <button\n                onClick={() => setPreviewFile(null)}\n                className=\"text-xs font-bold text-slate-400 hover:text-white p-1\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            <div className=\"space-y-2 text-xs font-mono text-slate-300 bg-white/5 p-4 rounded-xl border border-white/10\">\n              <div>Size: <b className=\"text-white\">{fmtSize(previewFile.size)}</b></div>\n              <div>Subfolder: <b className=\"text-indigo-400\">{selectedCat.targetSubfolder || selectedCat.name}</b></div>\n              <div>Sorting Engine: <b className=\"text-emerald-400\">{previewFile.engine || \'ollama\'}</b></div>\n              <div>Confidence: <b className=\"text-white\">{previewFile.conf ? `${Math.round(previewFile.conf * 100)}%` : \'95%\'}</b></div>\n            </div>\n\n            <div className=\"flex justify-end gap-2.5 mt-2\">\n              <button\n                onClick={() => {\n                  onUndoSortFile(previewFile.name, selectedCat.id);\n                  setPreviewFile(null);\n                }}\n                className=\"bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs py-2 px-4 rounded-xl transition-all flex items-center gap-1.5 shadow-lg shadow-rose-600/20\"\n              >\n                <Undo2 className=\"w-3.5 h-3.5\" />\n                <span>Undo & Restore File</span>\n              </button>\n              <button\n                onClick={() => setPreviewFile(null)}\n                className=\"bg-white/10 hover:bg-white/15 text-white font-bold text-xs py-2 px-4 rounded-xl border border-white/10 transition-all\"\n              >\n                Close\n              </button>\n            </div>\n          </div>\n        </div>\n      )}\n    </div>\n  );"
      }
      num_matches: 1
    }
  }
}
