    replacement_chunks {
      target_content: "  const getKindBadge = (kind: string) => {\n    switch (kind) {\n      case \'sorted\':\n        return \'bg-[#dcefe2] text-[#0e5c38]\';\n      case \'spawn\':\n        return \'bg-sky-100 text-[#33719f]\';\n      case \'skipped\':\n        return \'bg-[#f4e7cd] text-[#8a5d13]\';\n      case \'undo\':\n        return \'bg-purple-100 text-purple-800\';\n      case \'error\':\n        return \'bg-rose-100 text-rose-800\';\n      default:\n        return \'bg-[#e7e4d8] text-[#5c584c]\';\n    }\n  };\n\n  return (\n    <div className=\"flex flex-col gap-4 p-4 overflow-y-auto max-h-[calc(100vh-120px)] font-sans\">\n      {/* Header */}\n      <div className=\"flex items-baseline justify-between\">\n        <div>\n          <h2 className=\"font-display text-2xl font-extrabold text-[#211f19] tracking-tight\">\n            Activity Log & Undo Journal\n          </h2>\n          <p className=\"text-xs text-[#5c584c] mt-0.5\">\n            Real-time chronological log of file arrivals, AI classifications, moves, and undo operations.\n          </p>\n        </div>\n\n        <div className=\"flex gap-2\">\n          <button\n            onClick={onBulkUndo}\n            className=\"bg-[#c08427] hover:bg-[#a06b1d] text-white font-bold text-xs py-1.5 px-3 rounded-lg transition-all flex items-center gap-1.5 shadow-sm\"\n            title=\"Bulk Undo moves and restore files\"\n          >\n            <Undo2 className=\"w-3.5 h-3.5\" />\n            <span>Bulk Undo Moves</span>\n          </button>\n\n          <button\n            onClick={handleExportCsv}\n            className=\"bg-white hover:bg-[#efede4] text-[#5c584c] border border-[#cbc6b4] font-bold text-xs py-1.5 px-3 rounded-lg transition-all flex items-center gap-1.5\"\n          >\n            <Download className=\"w-3.5 h-3.5\" />\n            <span>Export CSV</span>\n          </button>\n\n          <button\n            onClick={onClearLogs}\n            className=\"bg-white hover:bg-rose-50 text-rose-700 border border-[#cbc6b4] font-bold text-xs py-1.5 px-3 rounded-lg transition-all flex items-center gap-1.5\"\n          >\n            <Trash2 className=\"w-3.5 h-3.5\" />\n            <span>Clear</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Filter Chips */}\n      <div className=\"flex gap-1.5 flex-wrap\">\n        {filterOptions.map((f) => (\n          <button\n            key={f.id}\n            onClick={() => setFilter(f.id)}\n            className={`font-semibold text-xs px-3 py-1 rounded-full border transition-all ${\n              filter === f.id\n                ? \'bg-[#211f19] text-white border-[#211f19]\'\n                : \'bg-white text-[#5c584c] border-[#cbc6b4] hover:border-[#177a4c]\'\n            }`}\n          >\n            {f.label}\n          </button>\n        ))}\n      </div>\n\n      {/* Activity Table */}\n      <div className=\"bg-white border border-[#dcd8c9] rounded-xl overflow-hidden shadow-sm\">\n        <table className=\"w-full text-left border-collapse text-xs font-mono\">\n          <thead>\n            <tr className=\"bg-[#efede4] border-b border-[#dcd8c9] text-[10px] uppercase font-bold text-[#8b8676] tracking-wider\">\n              <th className=\"p-3 pl-4\">Time</th>\n              <th className=\"p-3\">Event</th>\n              <th className=\"p-3\">File</th>\n              <th className=\"p-3\">Category / Note</th>\n              <th className=\"p-3\">Engine</th>\n              <th className=\"p-3\">Conf</th>\n              <th className=\"p-3\">Duration</th>\n              <th className=\"p-3 text-right pr-4\">Action</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-[#f4f2ea]\">\n            {filteredLogs.length === 0 ? (\n              <tr>\n                <td colSpan={8} className=\"p-8 text-center text-[#8b8676] font-sans\">\n                  No activity matching current filter.\n                </td>\n              </tr>\n            ) : (\n              filteredLogs.map((l) => {\n                const timeStr = new Date(l.t).toTimeString().slice(0, 8);\n\n                return (\n                  <tr key={l.id} className=\"hover:bg-[#efede4]/50 transition-colors\">\n                    <td className=\"p-2.5 pl-4 text-[#8b8676]\">{timeStr}</td>\n\n                    <td className=\"p-2.5\">\n                      <span className={`font-bold text-[9.5px] uppercase px-2 py-0.5 rounded-md ${getKindBadge(l.kind)}`}>\n                        {l.kind}\n                      </span>\n                    </td>\n\n                    <td className=\"p-2.5 font-semibold text-[#211f19] max-w-[200px] truncate\" title={l.file}>\n                      {l.file}\n                    </td>\n\n                    <td className=\"p-2.5\">\n                      {l.cat ? (\n                        <div className=\"flex items-center gap-1.5\">\n                          <span className=\"w-2 h-2 rounded-full\" style={{ backgroundColor: l.color || \'#177a4c\' }} />\n                          <span className=\"font-semibold text-[#211f19]\">{l.cat}</span>\n                        </div>\n                      ) : (\n                        <span className=\"text-[#8b8676] italic\">{l.note || \'\342\200\224\'}</span>\n                      )}\n                    </td>\n\n                    <td className=\"p-2.5\">\n                      {l.engine ? (\n                        <span className=\"bg-[#e7e4d8] text-[#5c584c] px-2 py-0.5 rounded text-[10px] font-bold\">\n                          {l.engine}\n                        </span>\n                      ) : (\n                        \'\342\200\224\'\n                      )}\n                    </td>\n\n                    <td className=\"p-2.5 text-[#8b8676]\">\n                      {l.conf ? `${Math.round(l.conf * 100)}%` : \'\342\200\224\'}\n                    </td>\n\n                    <td className=\"p-2.5 text-[#8b8676]\">\n                      {l.ms ? `${l.ms}ms` : \'\342\200\224\'}\n                    </td>\n\n                    <td className=\"p-2.5 pr-4 text-right\">\n                      {l.kind === \'sorted\' && (\n                        <button\n                          onClick={() => onUndoMove(l.file)}\n                          className=\"font-bold text-[10px] bg-white border border-[#cbc6b4] hover:bg-rose-50 hover:text-rose-700 text-[#5c584c] px-2.5 py-1 rounded-md transition-colors flex items-center gap-1 ml-auto\"\n                          title=\"Undo move and restore file\"\n                        >\n                          <Undo2 className=\"w-3 h-3\" />\n                          <span>Undo</span>\n                        </button>\n                      )}\n                    </td>\n                  </tr>\n                );\n              })\n            )}\n          </tbody>\n        </table>\n      </div>\n    </div>\n  );"
      replacement_content: "  const getKindBadge = (kind: string) => {\n    switch (kind) {\n      case \'sorted\':\n        return \'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30\';\n      case \'spawn\':\n        return \'bg-indigo-500/20 text-indigo-300 border border-indigo-500/30\';\n      case \'skipped\':\n        return \'bg-amber-500/20 text-amber-300 border border-amber-500/30\';\n      case \'undo\':\n        return \'bg-purple-500/20 text-purple-300 border border-purple-500/30\';\n      case \'error\':\n        return \'bg-rose-500/20 text-rose-300 border border-rose-500/30\';\n      default:\n        return \'bg-white/10 text-slate-300 border border-white/10\';\n    }\n  };\n\n  return (\n    <div className=\"flex flex-col gap-5 p-6 overflow-y-auto max-h-[calc(100vh-120px)] font-sans text-slate-200\">\n      {/* Header */}\n      <div className=\"flex items-baseline justify-between\">\n        <div>\n          <h2 className=\"text-3xl font-light tracking-tight text-white mb-1\">\n            Activity Log & Undo Journal\n          </h2>\n          <p className=\"text-xs text-slate-400\">\n            Real-time chronological log of file arrivals, AI classifications, moves, and undo operations.\n          </p>\n        </div>\n\n        <div className=\"flex gap-2\">\n          <button\n            onClick={onBulkUndo}\n            className=\"bg-amber-600 hover:bg-amber-500 text-white font-bold text-xs py-2 px-3.5 rounded-xl transition-all flex items-center gap-1.5 shadow-lg shadow-amber-600/20\"\n            title=\"Bulk Undo moves and restore files\"\n          >\n            <Undo2 className=\"w-3.5 h-3.5\" />\n            <span>Bulk Undo Moves</span>\n          </button>\n\n          <button\n            onClick={handleExportCsv}\n            className=\"bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10 font-bold text-xs py-2 px-3.5 rounded-xl transition-all flex items-center gap-1.5\"\n          >\n            <Download className=\"w-3.5 h-3.5\" />\n            <span>Export CSV</span>\n          </button>\n\n          <button\n            onClick={onClearLogs}\n            className=\"bg-white/5 hover:bg-rose-500/20 text-slate-300 hover:text-rose-300 border border-white/10 hover:border-rose-500/30 font-bold text-xs py-2 px-3.5 rounded-xl transition-all flex items-center gap-1.5\"\n          >\n            <Trash2 className=\"w-3.5 h-3.5\" />\n            <span>Clear</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Filter Chips */}\n      <div className=\"flex gap-2 flex-wrap\">\n        {filterOptions.map((f) => (\n          <button\n            key={f.id}\n            onClick={() => setFilter(f.id)}\n            className={`font-semibold text-xs px-3.5 py-1.5 rounded-full border transition-all ${\n              filter === f.id\n                ? \'bg-indigo-600 text-white border-indigo-500/50 shadow-md shadow-indigo-600/20 font-bold\'\n                : \'bg-white/5 text-slate-400 border-white/10 hover:border-white/20 hover:text-white\'\n            }`}\n          >\n            {f.label}\n          </button>\n        ))}\n      </div>\n\n      {/* Activity Table */}\n      <div className=\"bg-white/5 border border-white/10 rounded-2xl overflow-hidden shadow-lg backdrop-blur-sm\">\n        <table className=\"w-full text-left border-collapse text-xs font-mono\">\n          <thead>\n            <tr className=\"bg-black/30 border-b border-white/10 text-[10px] uppercase font-bold text-slate-400 tracking-wider\">\n              <th className=\"p-3 pl-5\">Time</th>\n              <th className=\"p-3\">Event</th>\n              <th className=\"p-3\">File</th>\n              <th className=\"p-3\">Category / Note</th>\n              <th className=\"p-3\">Engine</th>\n              <th className=\"p-3\">Conf</th>\n              <th className=\"p-3\">Duration</th>\n              <th className=\"p-3 text-right pr-5\">Action</th>\n            </tr>\n          </thead>\n          <tbody className=\"divide-y divide-white/5\">\n            {filteredLogs.length === 0 ? (\n              <tr>\n                <td colSpan={8} className=\"p-10 text-center text-slate-400 font-sans\">\n                  No activity matching current filter.\n                </td>\n              </tr>\n            ) : (\n              filteredLogs.map((l) => {\n                const timeStr = new Date(l.t).toTimeString().slice(0, 8);\n\n                return (\n                  <tr key={l.id} className=\"hover:bg-white/5 transition-colors\">\n                    <td className=\"p-3 pl-5 text-slate-400\">{timeStr}</td>\n\n                    <td className=\"p-3\">\n                      <span className={`font-bold text-[9.5px] uppercase px-2.5 py-0.5 rounded-full ${getKindBadge(l.kind)}`}>\n                        {l.kind}\n                      </span>\n                    </td>\n\n                    <td className=\"p-3 font-semibold text-white max-w-[200px] truncate\" title={l.file}>\n                      {l.file}\n                    </td>\n\n                    <td className=\"p-3\">\n                      {l.cat ? (\n                        <div className=\"flex items-center gap-1.5\">\n                          <span className=\"w-2 h-2 rounded-full\" style={{ backgroundColor: l.color || \'#6366f1\' }} />\n                          <span className=\"font-semibold text-slate-200\">{l.cat}</span>\n                        </div>\n                      ) : (\n                        <span className=\"text-slate-500 italic\">{l.note || \'\342\200\224\'}</span>\n                      )}\n                    </td>\n\n                    <td className=\"p-3\">\n                      {l.engine ? (\n                        <span className=\"bg-white/10 text-slate-300 border border-white/10 px-2 py-0.5 rounded-md text-[10px] font-bold\">\n                          {l.engine}\n                        </span>\n                      ) : (\n                        \'\342\200\224\'\n                      )}\n                    </td>\n\n                    <td className=\"p-3 text-slate-400\">\n                      {l.conf ? `${Math.round(l.conf * 100)}%` : \'\342\200\224\'}\n                    </td>\n\n                    <td className=\"p-3 text-slate-400\">\n                      {l.ms ? `${l.ms}ms` : \'\342\200\224\'}\n                    </td>\n\n                    <td className=\"p-3 pr-5 text-right\">\n                      {l.kind === \'sorted\' && (\n                        <button\n                          onClick={() => onUndoMove(l.file)}\n                          className=\"font-bold text-[10px] bg-white/10 border border-white/10 hover:bg-rose-500/20 hover:text-rose-300 hover:border-rose-500/30 text-slate-300 px-2.5 py-1 rounded-lg transition-all flex items-center gap-1 ml-auto\"\n                          title=\"Undo move and restore file\"\n                        >\n                          <Undo2 className=\"w-3 h-3\" />\n                          <span>Undo</span>\n                        </button>\n                      )}\n                    </td>\n                  </tr>\n                );\n              })\n            )}\n          </tbody>\n        </table>\n      </div>\n    </div>\n  );"
