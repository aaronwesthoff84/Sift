ss 2 physical drives.</p>\\n        </div>\\n        <div class=\\\"flex gap-4\\\">\\n          <div class=\\\"flex flex-col items-end\\\">\\n             <span class=\\\"text-[10px] uppercase font-bold text-slate-500 tracking-widest mb-1\\\">Ollama Status</span>\\n             <div class=\\\"flex items-center gap-2\\\">\\n               <div class=\\\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\\\"></div>\\n               <span class=\\\"text-sm text-emerald-400 font-medium\\\">Connected</span>\\n             </div>\\n          </div>\\n        </div>\\n      </div>\\n\\n      <!-- Statistics Cards -->\\n      <div class=\\\"grid grid-cols-4 gap-6\\\">\\n        <div class=\\\"bg-white/5 border border-white/10 p-4 rounded-2xl backdrop-blur-sm\\\">\\n          <div class=\\\"text-slate-500 text-xs font-bold uppercase tracking-wider mb-2\\\">Sorted Today</div>\\n          <div class=\\\"text-3xl font-light text-white tracking-tighter\\\">1,248</div>\\n          <div class=\\\"mt-2 text-[10px] text-emerald-400 font-medium\\\">+12% from yesterday</div>\\n        </div>\\n        <div class=\\\"bg-white/5 border border-white/10 p-4 rounded-2xl backdrop-blur-sm\\\">\\n          <div class=\\\"text-slate-500 text-xs font-bold uppercase tracking-wider mb-2\\\">Queue Depth</div>\\n          <div class=\\\"text-3xl font-light text-white tracking-tighter\\\">14</div>\\n          <div class=\\\"mt-2 text-[10px] text-slate-400 font-medium\\\">Avg processing 0.8s</div>\\n        </div>\\n        <div class=\\\"bg-white/5 border border-white/10 p-4 rounded-2xl backdrop-blur-sm\\\">\\n          <div class=\\\"text-slate-500 text-xs font-bold uppercase tracking-wider mb-2\\\">Success Rate</div>\\n          <div class=\\\"text-3xl font-light text-white tracking-tighter\\\">99.8%</div>\\n          <div class=\\\"mt-2 text-[10px] text-indigo-400 font-medium\\\">2 failures logged</div>\\n        </div>\\n        <div class=\\\"bg-white/5 border border-white/10 p-4 rounded-2xl backdrop-blur-sm\\\">\\n          <div class=\\\"text-slate-500 text-xs font-bold uppercase tracking-wider mb-2\\\">Space Saved</div>\\n          <div class=\\\"text-3xl font-light text-white tracking-tighter\\\">14.2 <span class=\\\"text-lg\\\">GB</span></div>\\n          <div class=\\\"mt-2 text-[10px] text-slate-400 font-medium\\\">Duplicates removed</div>\\n        </div>\\n      </div>\\n\\n      <!-- Watch List -->\\n      <div class=\\\"flex-1 flex flex-col bg-white/5 border border-white/10 rounded-2xl overflow-hidden backdrop-blur-sm\\\">\\n        <div class=\\\"px-6 py-4 border-b border-white/5 bg-white/5 flex justify-between items-center\\\">\\n          <span class=\\\"text-xs font-bold uppercase tracking-widest text-slate-400\\\">Watch Folders</span>\\n          <button class=\\\"px-3 py-1 bg-white/10 rounded-full text-[10px] font-bold uppercase tracking-widest hover:bg-white/20\\\">Refresh All</button>\\n        </div>\\n        <div class=\\\"flex-1 overflow-auto\\\">\\n          <table class=\\\"w-full text-left\\\">\\n            <thead>\\n              <tr class=\\\"text-[10px] uppercase tracking-widest text-slate-500\\\">\\n                <th class=\\\"px-6 py-3 font-semibold\\\">Source Path</th>\\n                <th class=\\\"px-6 py-3 font-semibold\\\">Status</th>\\n                <th class=\\\"px-6 py-3 font-semibold\\\">Last Activity</th>\\n                <th class=\\\"px-6 py-3 font-semibold text-right\\\">Actions</th>\\n              </tr>\\n            </thead>\\n            <tbody class=\\\"divide-y divide-white/5\\\">\\n              <tr class=\\\"group hover:bg-white/5\\\">\\n                <td class=\\\"px-6 py-4\\\">\\n                  <div class=\\\"text-sm text-white font-medium italic\\\">~/Downloads</div>\\n                  <div class=\\\"text-[10px] text-slate-500\\\">Sorting to: ~/Documents/Sorted_AI</div>\\n                </td>\\n                <td class=\\\"px-6 py-4\\\">\\n                  <span class=\\\"px-2 py-1 bg-emerald-500/10 text-emerald-400 text-[10px] rounded border border-emerald-500/20\\\">Active (Native)</span>\\n                </td>\\n                <td class=\\\"px-6 py-4 text-xs text-slate-400\\\">invoice_2023_Q4.pdf sorted <span class=\\\"text-indigo-400 font-mono\\\">2m ago</span></td>\\n                <td class=\\\"px-6 py-4 text-right\\\">\\n                  <button class=\\\"p-2 rounded-lg hover:bg-white/10 text-slate-400\\\"><svg class=\\\"w-4 h-4\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066\\\"/></svg></button>\\n                </td>\\n              </tr>\\n              <tr class=\\\"group hover:bg-white/5\\\">\\n                <td class=\\\"px-6 py-4\\\">\\n                  <div class=\\\"text-sm text-white font-medium italic\\\">/Volumes/Data/Ingest</div>\\n                  <div class=\\\"text-[10px] text-slate-500\\\">Sorting to: /Volumes/Archives/Organized</div>\\n                </td>\\n                <td class=\\\"px-6 py-4\\\">\\n                  <span class=\\\"px-2 py-1 bg-amber-500/10 text-amber-400 text-[10px] rounded border border-amber-500/20\\\">Polling (5s)</span>\\n                </td>\\n                <td class=\\\"px-6 py-4 text-xs text-slate-400\\\">Scanning 4,203 items...</td>\\n                <td class=\\\"px-6 py-4 text-right\\\">\\n                  <button class=\\\"p-2 rounded-lg hover:bg-white/10 text-slate-400\\\"><svg class=\\\"w-4 h-4\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066\\\"/></svg></button>\\n                </td>\\n              </tr>\\n              <tr class=\\\"group hover:bg-white/5\\\">\\n                <td class=\\\"px-6 py-4\\\">\\n                  <div class=\\\"text-sm text-white font-medium italic\\\">~/Desktop/Unsorted</div>\\n                  <div class=\\\"text-[10px] text-slate-500\\\">Sorting to: ~/Documents/Work/Ref</div>\\n                </td>\\n                <td class=\\\"px-6 py-4\\\">\\n                  <span class=\\\"px-2 py-1 bg-indigo-500/10 text-indigo-400 text-[10px] rounded border border-indigo-500/20\\\">Idle</span>\\n                </td>\\n                <td class=\\\"px-6 py-4 text-xs text-slate-400\\\">No activity in 4h</td>\\n                <td class=\\\"px-6 py-4 text-right\\\">\\n                  <button class=\\\"p-2 rounded-lg hover:bg-white/10 text-slate-400\\\"><svg class=\\\"w-4 h-4\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066\\\"/></svg></button>\\n                </td>\\n              </tr>\\n            </tbody>\\n          </table>\\n        </div>\\n      </div>\\n\\n      <!-- Footer Status Bar -->\\n      <div class=\\\"flex justify-between items-center bg-white/5 border border-white/10 px-6 py-3 rounded-2xl backdrop-blur-xl\\\">\\n        <div class=\\\"flex items-center gap-6\\\">\\n          <div class=\\\"flex items-center gap-2\\\">\\n            <span class=\\\"text-[10px] uppercase font-bold text-slate-500 tracking-widest\\\">Storage</span>\\n            <div class=\\\"w-32 h-1.5 bg-white/10 rounded-full overflow-hidden\\\">\\n              <div class=\\\"w-2/3 h-full bg-indigo-500\\\"></div>\\n            </div>\\n            <span class=\\\"text-[10px] text-slate-400\\\">67% Full</span>\\n          </div>\\n          <div class=\\\"flex items-center gap-2\\\">\\n             <span class=\\\"text-[10px] uppercase font-bold text-slate-500 tracking-widest\\\">Journal</span>\\n             <span class=\\\"text-[10px] text-emerald-400\\\">SQLite Sync OK</span>\\n          </div>\\n        </div>\\n        <div class=\\\"flex gap-4\\\">\\n          <span class=\\\"text-[10px] text-slate-500\\\">macOS Sequoia 15.1</span>\\n          <span class=\\\"text-[10px] text-slate-500\\\">|</span>\\n          <span class=\\\"text-[10px] text-slate-500 italic\\\">Local Ollama Engine Running</span>\\n        </div>\\n      </div>\\n    </div>\\n  </div>\\n</div>\\n                    </body>\\n                  </html>\nDesign instructions: Extract ONLY the styling (colors, fonts, spacing, borders, shadows, backgrounds, gradients) and layout patterns (flexbox/grid structure, component arrangement) from the Design HTML above. Do NOT replace or restructure the existing app\'s HTML elements \342\200\224 preserve all existing components, content, and functionality. Only modify CSS/styling and adjust layout containers as needed to match the theme\'s aesthetic. You MUST execute file editing or creation tool calls (such as edit_file, multi_edit_file, or create_file) to apply styling updates to target files directly. Do NOT output code blocks, HTML, or TSX directly in your text chat response.\n[AIS_METADATA_SECTION_END]"
    items {
      text: "Apply the \"Frosted Glass\" design theme to the app.\n[AIS_METADATA_SECTION_START]\nDesign name: Frosted Glass\nDesign HTML:                   <!doctype html>\\n                  <html style=\\\"height: 100%; margin: 0;\\\">\\n                    <head>\\n                      <meta charset=\\\"UTF-8\\\" />\\n                      <meta name=\\\"viewport\\\" content=\\\"width=device-width, initial-scale=1.0\\\" />\\n                      <script src=\\\"https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4\\\"></script>\\n                      <link href=\\\"https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200\\\" rel=\\\"stylesheet\\\" />\\n                      <style>\\n                        body { margin: 0; height: 100%; display: flex; flex-direction: column; overflow: hidden; }\\n                        /* Fallback classes in case Tailwind fails to load in sandbox */\\n                        .h-full { height: 100%; }\\n                        .w-full { width: 100%; }\\n                        .flex { display: flex; }\\n                        .flex-col { flex-direction: column; }\\n                        .flex-1 { flex: 1 1 0%; }\\n                      </style>\\n                    </head>\\n                    <body>\\n                      <div class=\\\"flex flex-col w-[1024px] h-[768px] bg-[#0c0d0e] text-slate-200 font-sans overflow-hidden border border-white/10\\\">\\n  <!-- Title Bar / Window Controls -->\\n  <div class=\\\"flex items-center justify-between px-4 py-2 bg-black/40 backdrop-blur-md border-b border-white/5\\\">\\n    <div class=\\\"flex items-center gap-6\\\">\\n      <div class=\\\"flex gap-2\\\">\\n        <div class=\\\"w-3 h-3 rounded-full bg-rose-500/80\\\"></div>\\n        <div class=\\\"w-3 h-3 rounded-full bg-amber-500/80\\\"></div>\\n        <div class=\\\"w-3 h-3 rounded-full bg-emerald-500/80\\\"></div>\\n      </div>\\n      <div class=\\\"flex items-center gap-2\\\">\\n        <svg class=\\\"w-5 h-5 text-indigo-400\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.628.282a2 2 0 01-1.808 0l-.63-.282a6 6 0 00-3.86-.517l-2.387.477a2 2 0 00-1.022.547l-.54.54a2 2 0 000 2.828l1.246 1.246a2 2 0 002.828 0l.54-.54a2 2 0 011.022-.547l2.387-.477a6 6 0 013.86.517l.628.282a2 2 0 001.808 0l.63-.282a6 6 0 013.86.517l2.387-.477a2 2 0 011.022.547l.54.54a2 2 0 010 2.828l-1.246 1.246a2 2 0 01-2.828 0l-.54-.54z\\\"/></svg>\\n        <span class=\\\"font-bold tracking-tight text-white\\\">SIFT.AI <span class=\\\"text-xs font-normal text-slate-500 ml-1\\\">v2.0.4</span></span>\\n      </div>\\n    </div>\\n    \\n    <!-- Persistent Top Bar Controls -->\\n    <div class=\\\"flex items-center gap-4 bg-white/5 rounded-lg px-3 py-1 border border-white/10\\\">\\n      <div class=\\\"flex items-center gap-2\\\">\\n        <span class=\\\"text-[10px] uppercase font-bold text-slate-500 tracking-widest\\\">Active Model</span>\\n        <div class=\\\"flex items-center gap-2 px-2 py-0.5 bg-indigo-500/20 text-indigo-300 rounded border border-indigo-500/30 text-xs\\\">\\n          llama3-8b-instruct:latest\\n          <svg class=\\\"w-3 h-3\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" stroke-width=\\\"2\\\" d=\\\"M19 9l-7 7-7-7\\\"/></svg>\\n        </div>\\n      </div>\\n      <div class=\\\"h-4 w-px bg-white/10\\\"></div>\\n      <div class=\\\"flex items-center gap-3\\\">\\n        <span class=\\\"text-[10px] uppercase font-bold text-slate-500 tracking-widest\\\">Auto-Sort</span>\\n        <div class=\\\"w-8 h-4 bg-indigo-600 rounded-full relative\\\">\\n          <div class=\\\"absolute right-0.5 top-0.5 w-3 h-3 bg-white rounded-full\\\"></div>\\n        </div>\\n      </div>\\n    </div>\\n  </div>\\n\\n  <div class=\\\"flex flex-1 overflow-hidden\\\">\\n    <!-- Sidebar Tabs -->\\n    <div class=\\\"w-20 flex flex-col items-center py-8 gap-8 border-r border-white/5 bg-black/20\\\">\\n      <button class=\\\"flex flex-col items-center gap-1 group\\\">\\n        <div class=\\\"w-12 h-12 flex items-center justify-center rounded-2xl bg-white/10 text-indigo-400 group-hover:bg-white/15 transition-all shadow-lg shadow-indigo-500/10\\\">\\n          <svg class=\\\"w-6 h-6\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\\\"/><path d=\\\"M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z\\\"/></svg>\\n        </div>\\n        <span class=\\\"text-[10px] font-medium text-indigo-400\\\">Watch</span>\\n      </button>\\n      <button class=\\\"flex flex-col items-center gap-1 opacity-40 hover:opacity-100 transition-all\\\">\\n        <div class=\\\"w-12 h-12 flex items-center justify-center rounded-2xl bg-white/5\\\">\\n          <svg class=\\\"w-6 h-6\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4\\\"/></svg>\\n        </div>\\n        <span class=\\\"text-[10px] font-medium\\\">Shelf</span>\\n      </button>\\n      <button class=\\\"flex flex-col items-center gap-1 opacity-40 hover:opacity-100 transition-all\\\">\\n        <div class=\\\"w-12 h-12 flex items-center justify-center rounded-2xl bg-white/5\\\">\\n          <svg class=\\\"w-6 h-6\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4\\\"/></svg>\\n        </div>\\n        <span class=\\\"text-[10px] font-medium\\\">Rules</span>\\n      </but