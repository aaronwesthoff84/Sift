  </div>\\n      </div>\\n    </div>\\n  </div>\\n\\n  <div class=\\\"flex flex-1 overflow-hidden\\\">\\n    <!-- Sidebar Tabs -->\\n    <div class=\\\"w-20 flex flex-col items-center py-8 gap-8 border-r border-white/5 bg-black/20\\\">\\n      <button class=\\\"flex flex-col items-center gap-1 group\\\">\\n        <div class=\\\"w-12 h-12 flex items-center justify-center rounded-2xl bg-white/10 text-indigo-400 group-hover:bg-white/15 transition-all shadow-lg shadow-indigo-500/10\\\">\\n          <svg class=\\\"w-6 h-6\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M15 12a3 3 0 11-6 0 3 3 0 016 0z\\\"/><path d=\\\"M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z\\\"/></svg>\\n        </div>\\n        <span class=\\\"text-[10px] font-medium text-indigo-400\\\">Watch</span>\\n      </button>\\n      <button class=\\\"flex flex-col items-center gap-1 opacity-40 hover:opacity-100 transition-all\\\">\\n        <div class=\\\"w-12 h-12 flex items-center justify-center rounded-2xl bg-white/5\\\">\\n          <svg class=\\\"w-6 h-6\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4\\\"/></svg>\\n        </div>\\n        <span class=\\\"text-[10px] font-medium\\\">Shelf</span>\\n      </button>\\n      <button class=\\\"flex flex-col items-center gap-1 opacity-40 hover:opacity-100 transition-all\\\">\\n        <div class=\\\"w-12 h-12 flex items-center justify-center rounded-2xl bg-white/5\\\">\\n          <svg class=\\\"w-6 h-6\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" viewBox=\\\"0 0 24 24\\\"><path d=\\\"M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4\\\"/></svg>\\n        </div>\\n        <span class=\\\"text-[10px] font-medium\\\">Rules</span>\\n    