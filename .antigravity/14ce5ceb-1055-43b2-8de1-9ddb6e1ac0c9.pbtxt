    replacement_chunks {
      target_content: "  return (\n    <div\n      onDragOver={handleDragOver}\n      onDragLeave={handleDragLeave}\n      onDrop={handleDrop}\n      className=\"min-h-screen bg-[#0c1410] text-[#211f19] flex items-center justify-center p-2 sm:p-4 font-sans select-none relative\"\n    >\n      {/* Hidden File Input for Upload */}\n      <input\n        type=\"file\"\n        multiple\n        ref={fileInputRef}\n        onChange={(e) => e.target.files && handleUploadFiles(e.target.files)}\n        className=\"hidden\"\n      />\n\n      {/* Main Desktop Window Container */}\n      <div className=\"w-full max-w-[1280px] h-[90vh] min-h-[620px] bg-[#f6f4ee] rounded-2xl border border-black/30 shadow-2xl overflow-hidden flex flex-col relative z-10\">\n        {/* Top Desktop Chrome Toolbar */}\n        <TopBar\n          platform={platform}\n          setPlatform={setPlatform}\n          watching={watching}\n          onToggleWatch={() => setWatching(!watching)}\n          watchPath={watchPath}\n          onEditPath={() => setPermissionModal({ isOpen: true, path: watchPath })}\n          models={models}\n          selectedModel={selectedModel}\n          onSelectModel={setSelectedModel}\n          mode={mode}\n          onSetMode={setMode}\n          onSimulate={handleSimulateFile}\n          onUploadClick={() => fileInputRef.current?.click()}\n          engineOnline={ollamaStatus.connected}\n          engineName={selectedModel}\n          hasGeminiKey={hasGeminiKey}\n        />\n\n        {/* Main Body */}\n        <div className=\"flex-1 flex min-h-0 bg-[#f6f4ee]\">\n          {/* Sidebar Navigation */}\n          <Sidebar\n            activeTab={activeTab}\n            setActiveTab={setActiveTab}\n            queueLength={files.length}\n            ollamaStatus={ollamaStatus}\n            onTestOllama={() => testOllamaConnection()}\n          />\n\n          {/* Tab Views Content */}\n          <main className=\"flex-1 min-w-0 bg-[#f6f4ee] overflow-hidden relative\">\n            {activeTab === \'watch\' && (\n              <WatchView\n                files={files}\n                categories={categories}\n                mode={mode}\n                onApproveFile={handleApproveFile}\n                onSkipFile={handleSkipFile}\n                totals={totals}\n                histMs={histMs}\n                consoleLogs={consoleLogs}\n                onClearConsole={() => setConsoleLogs([])}\n                recentDecisions={recentDecisions}\n                watching={watching}\n                watchPath={watchPath}\n              />\n            )}\n\n            {activeTab === \'shelf\' && (\n              <ShelfView\n                categories={categories}\n                shelfData={shelfData}\n                selectedCatId={selectedCatId}\n                onSelectCategory={setSelectedCatId}\n                onUndoSortFile={handleUndoMove}\n                shelfDirPath={shelfPath}\n              />\n            )}\n\n            {activeTab === \'rules\' && (\n              <RulesView\n                rules={rules}\n                onUpdateRules={handleUpdateRules}\n                promptTemplate={settings.promptTemplate}\n                onUpdatePromptTemplate={(tpl) =>\n                  handleUpdateSettings({ ...settings, promptTemplate: tpl })\n                }\n                onResetRules={() => {\n                  setCategories(DEFAULT_CATEGORIES);\n                  if (rules[0]) {\n                    handleUpdateRules([{ ...rules[0], categories: DEFAULT_CATEGORIES }]);\n                  }\n                }}\n              />\n            )}\n\n            {activeTab === \'activity\' && (\n              <ActivityView\n                logs={activityLog}\n                onClearLogs={() => {\n                  setActivityLog([]);\n                  fetch(\'/api/activity/clear\', { method: \'POST\' });\n                }}\n                onUndoMove={handleUndoMove}\n                onBulkUndo={handleBulkUndo}\n              />\n            )}\n\n            {activeTab === \'settings\' && (\n              <SettingsView\n                settings={settings}\n                onUpdateSettings={handleUpdateSettings}\n                onTestOllama={() => testOllamaConnection()}\n                hasGeminiKey={hasGeminiKey}\n                platform={platform}\n                permissions={[\n                  { path: watchPath, platform, granted: true, scope: \'watch-folder\' },\n                  { path: shelfPath, platform, granted: true, scope: \'shelf-folder\' },\n                ]}\n                onRequestPermission={(p) => setPermissionModal({ isOpen: true, path: p })}\n                onResetAll={() => {\n                  localStorage.clear();\n                  window.location.reload();\n                }}\n              />\n            )}\n          </main>\n        </div>\n\n        {/* Footer Statusbar */}\n        <footer className=\"h-7 bg-[#efede4] border-t border-[#dcd8c9] px-4 flex items-center justify-between text-[11px] font-mono text-[#5c584c]\">\n          <div className=\"flex items-center gap-2\">\n            <span\n              className={`w-2 h-2 rounded-full ${\n                watching ? \'bg-emerald-500 animate-pulse\' : \'bg-gray-400\'\n              }`}\n            />\n            <span>{watching ? `Watching ${watchPath}` : \'Paused\'}</span>\n          </div>\n\n          <div className=\"hidden sm:block text-[#8b8676]\">\n            drop files anywhere to sort them \302\267 <kbd className=\"bg-white border px-1 rounded\">S</kbd> simulate file\n          </div>\n\n          <div>\n            engine: <b>{ollamaStatus.connected ? `ollama (${selectedModel})` : hasGeminiKey ? \'gemini fallback\' : \'heuristic\'}</b>\n          </div>\n        </footer>\n      </div>\n\n      {/* Drag & Drop Visual Overlay */}\n      {isDropOver && (\n        <div className=\"fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center pointer-events-none\">\n          <div className=\"border-4 border-dashed border-emerald-400 rounded-3xl p-12 text-center text-white font-sans max-w-lg\">\n            <div className=\"text-4xl mb-3\">\360\237\223\245</div>\n            <h2 className=\"font-display font-extrabold text-2xl\">\n              Release to Drop into Watch Folder\n            </h2>\n            <p className=\"text-xs font-mono text-emerald-200 mt-2\">\n              Sift will read filenames & metadata and sort them via AI\n            </p>\n          </div>\n        </div>\n      )}"
      replacement_content: "  return (\n    <div\n      onDragOver={handleDragOver}\n      onDragLeave={handleDragLeave}\n      onDrop={handleDrop}\n      className=\"min-h-screen bg-[#08090a] text-slate-200 flex items-center justify-center p-2 sm:p-4 font-sans select-none relative overflow-hidden\"\n    >\n      {/* Background Ambient Glows for Frosted Glass Effect */}\n      <div className=\"absolute -top-40 -left-40 w-96 h-96 bg-indigo-600/15 rounded-full blur-3xl pointer-events-none\" />\n      <div className=\"absolute -bottom-40 -right-40 w-96 h-96 bg-emerald-600/10 rounded-full blur-3xl pointer-events-none\" />\n\n      {/* Hidden File Input for Upload */}\n      <input\n        type=\"file\"\n        multiple\n        ref={fileInputRef}\n        onChange={(e) => e.target.files && handleUploadFiles(e.target.files)}\n        className=\"hidden\"\n      />\n\n      {/* Main Desktop Window Container */}\n      <div className=\"w-full max-w-[1280px] h-[90vh] min-h-[620px] bg-[#0c0d0e]/90 border border-white/10 shadow-2xl backdrop-blur-2xl rounded-2xl overflow-hidden flex flex-col relative z-10\">\n        {/* Top Desktop Chrome Toolbar */}\n        <TopBar\n          platform={platform}\n          setPlatform={setPlatform}\n          watching={watching}\n          onToggleWatch={() => setWatching(!watching)}\n          watchPath={watchPath}\n          onEditPath={() => setPermissionModal({ isOpen: true, path: watchPath })}\n          models={models}\n          selectedModel={selectedModel}\n          onSelectModel={setSelectedModel}\n          mode={mode}\n          onSetMode={setMode}\n          onSimulate={handleSimulateFile}\n          onUploadClick={() => fileInputRef.current?.click()}\n          engineOnline={ollamaStatus.connected}\n          engineName={selectedModel}\n          hasGeminiKey={hasGeminiKey}\n        />\n\n        {/* Main Body */}\n        <div className=\"flex-1 flex min-h-0 bg-[#0c0d0e]/40\">\n          {/* Sidebar Navigation */}\n          <Sidebar\n            activeTab={activeTab}\n            setActiveTab={setActiveTab}\n            queueLength={files.length}\n            ollamaStatus={ollamaStatus}\n            onTestOllama={() => testOllamaConnection()}\n          />\n\n          {/* Tab Views Content */}\n          <main className=\"flex-1 min-w-0 bg-transparent overflow-hidden relative\">\n            {activeTab === \'watch\' && (\n              <WatchView\n                files={files}\n                categories={categories}\n                mode={mode}\n                onApproveFile={handleApproveFile}\n                onSkipFile={handleSkipFile}\n                totals={totals}\n                histMs={histMs}\n                consoleLogs={consoleLogs}\n                onClearConsole={() => setConsoleLogs([])}\n                recentDecisions={recentDecisions}\n                watching={watching}\n                watchPath={watchPath}\n              />\n            )}\n\n            {activeTab === \'shelf\' && (\n              <ShelfView\n                categories={categories}\n                shelfData={shelfData}\n                selectedCatId={selectedCatId}\n                onSelectCategory={setSelectedCatId}\n                onUndoSortFile={handleUndoMove}\n                shelfDirPath={shelfPath}\n              />\n            )}\n\n            {activeTab === \'rules\' && (\n              <RulesView\n                rules={rules}\n                onUpdateRules={handleUpdateRules}\n                promptTemplate={settings.promptTemplate}\n                onUpdatePromptTemplate={(tpl) =>\n                  handleUpdateSettings({ ...settings, promptTemplate: tpl })\n                }\n                onResetRules={() => {\n                  setCategories(DEFAULT_CATEGORIES);\n                  if (rules[0]) {\n                    handleUpdateRules([{ ...rules[0], categories: DEFAULT_CATEGORIES }]);\n                  }\n                }}\n              />\n            )}\n\n            {activeTab === \'activity\' && (\n              <ActivityView\n                logs={activityLog}\n                onClearLogs={() => {\n                  setActivityLog([]);\n                  fetch(\'/api/activity/clear\', { method: \'POST\' });\n                }}\n                onUndoMove={handleUndoMove}\n                onBulkUndo={handleBulkUndo}\n              />\n            )}\n\n            {activeTab === \'settings\' && (\n              <SettingsView\n                settings={settings}\n                onUpdateSettings={handleUpdateSettings}\n                onTestOllama={() => testOllamaConnection()}\n                hasGeminiKey={hasGeminiKey}\n                platform={platform}\n                permissions={[\n                  { path: watchPath, platform, granted: true, scope: \'watch-folder\' },\n                  { path: shelfPath, platform, granted: true, scope: \'shelf-folder\' },\n                ]}\n                onRequestPermission={(p) => setPermissionModal({ isOpen: true, path: p })}\n                onResetAll={() => {\n                  localStorage.clear();\n                  window.location.reload();\n                }}\n              />\n            )}\n          </main>\n        </div>\n\n        {/* Footer Statusbar */}\n        <footer className=\"h-8 bg-black/40 border-t border-white/10 px-4 flex items-center justify-between text-[11px] font-mono text-slate-400\">\n          <div className=\"flex items-center gap-2\">\n            <span\n              className={`w-2 h-2 rounded-full ${\n                watching ? \'bg-emerald-400 animate-pulse\' : \'bg-slate-600\'\n              }`}\n            />\n            <span>{watching ? `Watching ${watchPath}` : \'Paused\'}</span>\n          </div>\n\n          <div className=\"hidden sm:block text-slate-500\">\n            drop files anywhere to sort them \302\267 <kbd className=\"bg-white/10 border border-white/10 px-1 rounded text-slate-300\">S</kbd> simulate file\n          </div>\n\n          <div>\n            engine: <b className=\"text-slate-200\">{ollamaStatus.connected ? `ollama (${selectedModel})` : hasGeminiKey ? \'gemini fallback\' : \'heuristic\'}</b>\n          </div>\n        </footer>\n      </div>\n\n      {/* Drag & Drop Visual Overlay */}\n      {isDropOver && (\n        <div className=\"fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center pointer-events-none\">\n          <div className=\"border-2 border-dashed border-indigo-400/80 bg-black/60 rounded-3xl p-12 text-center text-white font-sans max-w-lg shadow-2xl\">\n            <div className=\"text-4xl mb-3\">\360\237\223\245</div>\n            <h2 className=\"font-display font-extrabold text-2xl tracking-tight text-white\">\n              Release to Drop into Watch Folder\n            </h2>\n            <p className=\"text-xs font-mono text-indigo-300 mt-2\">\n              Sift will read filenames & metadata and sort them via AI\n            </p>\n          </div>\n        </div>\n      )}"
