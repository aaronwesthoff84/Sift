    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Eye, FolderArchive, Sliders, Activity, Settings as SettingsIcon, RefreshCw } from \'lucide-react\';\nimport { OllamaStatus } from \'../types\';\n\ninterface SidebarProps {\n  activeTab: string;\n  setActiveTab: (tab: string) => void;\n  queueLength: number;\n  ollamaStatus: OllamaStatus;\n  onTestOllama: () => void;\n}\n\nexport const Sidebar: React.FC<SidebarProps> = ({\n  activeTab,\n  setActiveTab,\n  queueLength,\n  ollamaStatus,\n  onTestOllama,\n}) => {\n  const navItems = [\n    { id: \'watch\', label: \'Watch\', icon: Eye, badge: queueLength > 0 ? queueLength : null },\n    { id: \'shelf\', label: \'Shelf\', icon: FolderArchive },\n    { id: \'rules\', label: \'Rules\', icon: Sliders },\n    { id: \'activity\', label: \'Activity\', icon: Activity },\n    { id: \'settings\', label: \'Settings\', icon: SettingsIcon },\n  ];\n\n  const getDotStatus = () => {\n    if (ollamaStatus.connected === true) return { color: \'bg-emerald-500 animate-pulse\', text: \'Ollama Online\' };\n    if (ollamaStatus.connected === false) return { color: \'bg-rose-500\', text: \'Offline \302\267 Heuristics\' };\n    return { color: \'bg-amber-500 animate-spin\', text: \'Connecting\342\200\246\' };\n  };\n\n  const status = getDotStatus();\n\n  return (\n    <aside className=\"w-[212px] flex-none bg-[#efede4] border-r border-[#dcd8c9] flex flex-col p-3 gap-1 select-none\">\n      {navItems.map((item) => {\n        const Icon = item.icon;\n        const isActive = activeTab === item.id;\n\n        return (\n          <button\n            key={item.id}\n            onClick={() => setActiveTab(item.id)}\n            className={`flex items-center gap-2.5 w-full text-xs font-semibold px-3 py-2 rounded-lg transition-all text-left relative ${\n              isActive\n                ? \'bg-white text-[#0e5c38] shadow-sm font-bold border border-[#dcd8c9]\'\n                : \'text-[#5c584c] hover:bg-black/5 hover:text-[#211f19]\'\n            }`}\n          >\n            <Icon className={`w-4 h-4 flex-none ${isActive ? \'text-[#177a4c]\' : \'opacity-70\'}`} />\n            <span>{item.label}</span>\n\n            {item.badge !== null && item.badge !== undefined && (\n              <span className=\"ml-auto font-mono font-bold text-[10px] bg-[#c08427] text-white rounded-full px-1.5 py-0.2 min-w-[18px] text-center\">\n                {item.badge}\n              </span>\n            )}\n          </button>\n        );\n      })}\n\n      <div className=\"font-bold text-[9.5px] uppercase tracking-wider text-[#8b8676] px-3 pt-4 pb-1\">\n        Engine Status\n      </div>\n\n      {/* Ollama Engine Status Card */}\n      <div className=\"mt-auto bg-white border border-[#dcd8c9] rounded-xl p-3 shadow-sm flex flex-col gap-1.5\">\n        <div className=\"flex items-center gap-2 text-xs font-bold text-[#211f19]\">\n          <span className={`w-2 h-2 rounded-full flex-none ${status.color}`} />\n          <span>{status.text}</span>\n        </div>\n\n        <div className=\"font-mono text-xs font-semibold text-[#0e5c38] truncate\">\n          {ollamaStatus.availableModels[0] || \'llama3.2\'}\n        </div>\n\n        <div className=\"font-mono text-[10px] text-[#8b8676]\">\n          127.0.0.1:11434 {ollamaStatus.latencyMs ? `\302\267 ${ollamaStatus.latencyMs}ms` : \'\'}\n        </div>\n\n        <button\n          onClick={onTestOllama}\n          className=\"mt-1 w-full text-[10.5px] font-semibold py-1.5 px-2 rounded-md border border-[#cbc6b4] bg-[#efede4] hover:bg-[#dcefe2] hover:border-[#177a4c] transition-all flex items-center justify-center gap-1.5\"\n        >\n          <RefreshCw className=\"w-3 h-3 text-[#177a4c]\" />\n          <span>Test Connection</span>\n        </button>\n      </div>\n    </aside>\n  );\n};\n"
    }
