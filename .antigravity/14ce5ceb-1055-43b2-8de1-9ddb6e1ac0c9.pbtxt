      target_content: "  return (\n    <div className=\"fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n      <div className=\"bg-[#f6f4ee] border border-[#dcd8c9] rounded-2xl p-6 max-w-md w-full shadow-2xl flex flex-col gap-4 font-sans animate-in fade-in zoom-in-95 duration-200\">\n        <div className=\"flex items-center gap-3\">\n          <div className=\"w-10 h-10 rounded-xl bg-[#dcefe2] text-[#0e5c38] flex items-center justify-center flex-none\">\n            <Lock className=\"w-5 h-5\" />\n          </div>\n          <div>\n            <h3 className=\"font-display font-extrabold text-base text-[#211f19]\">\n              {platform === \'macos\'\n                ? \'Security-Scoped Access Request\'\n                : platform === \'windows\'\n                ? \'Windows Folder Permission\'\n                : \'Linux Filesystem Access\'}\n            </h3>\n            <p className=\"text-xs text-[#8b8676]\">\n              Sift requires OS authorization to monitor and sort files in this directory.\n            </p>\n          </div>\n        </div>\n\n        <div className=\"p-3 bg-white border border-[#dcd8c9] rounded-xl font-mono text-xs flex items-center gap-2\">\n          <Folder className=\"w-4 h-4 text-[#c08427] flex-none\" />\n          <span className=\"truncate text-[#211f19] font-semibold\">{path}</span>\n        </div>\n\n        <div className=\"text-xs text-[#5c584c] leading-relaxed bg-[#efede4] p-3 rounded-xl border border-[#cbc6b4]\">\n          {platform === \'macos\' && (\n            <p>\n              macOS sandbox security requires a persistent security-scoped bookmark to read events and move items safely without requesting password authorization again.\n            </p>\n          )}\n          {platform === \'windows\' && (\n            <p>\n              Windows File API grants Read/Write permissions inside AppData and User Directories for background file auto-sorting.\n            </p>\n          )}\n          {platform === \'linux\' && (\n            <p>\n              Linux Inotify monitoring requires read and write access to the target path.\n            </p>\n          )}\n        </div>\n\n        <div className=\"flex justify-end gap-2 pt-2\">\n          <button\n            onClick={onCancel}\n            className=\"bg-white hover:bg-[#efede4] text-[#5c584c] border border-[#cbc6b4] font-bold text-xs py-2 px-4 rounded-lg transition-all\"\n          >\n            Cancel\n          </button>\n          <button\n            onClick={onGrant}\n            className=\"bg-[#177a4c] hover:bg-[#0e5c38] text-white font-bold text-xs py-2 px-5 rounded-lg transition-all shadow-md flex items-center gap-1.5\"\n          >\n            <ShieldCheck className=\"w-4 h-4\" />\n            <span>Grant Access</span>\n          </button>\n        </div>\n      </div>\n    </div>\n  );"
