    replacement_chunks {
      target_content: "  return (\n    <div className=\"flex flex-col gap-4 p-4 overflow-y-auto max-h-[calc(100vh-120px)] font-sans\">\n      {/* Header */}\n      <div className=\"flex items-baseline justify-between\">\n        <div>\n          <h2 className=\"font-display text-2xl font-extrabold text-[#211f19] tracking-tight\">\n            Sorting Rules & Target Categories\n          </h2>\n          <p className=\"text-xs text-[#5c584c] mt-0.5\">\n            Configure subfolders, keywords, and description hints provided to Ollama / Gemini AI prompt contexts.\n          </p>\n        </div>\n\n        <button\n          onClick={handleCreate}\n          className=\"bg-[#177a4c] hover:bg-[#0e5c38] text-white font-bold text-xs py-2 px-3.5 rounded-lg transition-all shadow-sm flex items-center gap-1.5\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>New Category Rule</span>\n        </button>\n      </div>\n\n      {/* Rules Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3.5\">\n        {categories.map((c) => (\n          <div\n            key={c.id}\n            className=\"border border-[#dcd8c9] bg-white rounded-xl p-4 shadow-sm flex flex-col justify-between transition-all\"\n            style={{ borderLeftWidth: \'5px\', borderLeftColor: c.color }}\n          >\n            <div>\n              <div className=\"flex justify-between items-start\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"w-2.5 h-2.5 rounded-full\" style={{ backgroundColor: c.color }} />\n                  <h3 className=\"font-display font-bold text-base text-[#211f19]\">{c.name}</h3>\n                </div>\n\n                <div className=\"flex items-center gap-1\">\n                  <button\n                    onClick={() => handleEdit(c)}\n                    className=\"p-1 rounded hover:bg-[#efede4] text-[#5c584c] transition-colors\"\n                    title=\"Edit Rule\"\n                  >\n                    <Edit2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                  <button\n                    onClick={() => onDeleteCategory(c.id)}\n                    className=\"p-1 rounded hover:bg-rose-100 text-rose-700 transition-colors\"\n                    title=\"Delete Category\"\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              </div>\n\n              <div className=\"mt-1.5 text-xs font-mono text-[#177a4c]\">\n                Subfolder: <code className=\"bg-[#efede4] px-1.5 py-0.5 rounded text-[#211f19]\">/{c.targetSubfolder}</code>\n              </div>\n\n              <p className=\"text-xs text-[#5c584c] my-2.5 leading-relaxed\">\n                {c.description || \'No prompt description hint specified.\'}\n              </p>\n\n              {/* Keyword Badges */}\n              <div className=\"flex flex-wrap gap-1 mt-2\">\n                {c.keywords.map((k, idx) => (\n                  <span\n                    key={idx}\n                    className=\"font-mono text-[10.5px] bg-[#efede4] text-[#211f19] border border-[#cbc6b4] px-2 py-0.5 rounded-md\"\n                  >\n                    #{k}\n                  </span>\n                ))}\n              </div>\n            </div>\n\n            <div className=\"mt-3 pt-2.5 border-t border-[#f4f2ea] flex items-center justify-between text-[10.5px] font-mono text-[#8b8676]\">\n              <span>Rule ID: {c.id}</span>\n              <span className=\"text-[#0e5c38]\">\342\227\217 Prompt Active</span>\n            </div>\n          </div>\n        ))}\n      </div>\n\n      {/* Edit / Create Rule Modal */}\n      {isEditing && (\n        <div className=\"fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-center justify-center p-4\">\n          <form\n            onSubmit={handleSave}\n            className=\"bg-white border border-[#dcd8c9] rounded-2xl p-5 max-w-lg w-full shadow-2xl flex flex-col gap-3 text-[#211f19]\"\n          >\n            <div className=\"flex justify-between items-center pb-2 border-b border-[#dcd8c9]\">\n              <h3 className=\"font-display font-bold text-base\">\n                {editingCategory.id ? \'Edit Category Rule\' : \'Create Category Rule\'}\n              </h3>\n              <button\n                type=\"button\"\n                onClick={() => setIsEditing(false)}\n                className=\"text-xs font-bold text-[#8b8676] hover:text-black\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            <div className=\"space-y-3 text-xs font-sans\">\n              <div>\n                <label className=\"block font-bold text-[#5c584c] mb-1\">\n                  Category Name\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  value={editingCategory.name || \'\'}\n                  onChange={(e) =>\n                    setEditingCategory({ ...editingCategory, name: e.target.value })\n                  }\n                  placeholder=\"e.g. Invoices & Receipts\"\n                  className=\"w-full font-mono bg-white border border-[#cbc6b4] focus:border-[#177a4c] focus:outline-none rounded-lg px-3 py-1.5 text-[#211f19]\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block font-bold text-[#5c584c] mb-1\">\n                  Target Subfolder Name\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  value={editingCategory.targetSubfolder || \'\'}\n                  onChange={(e) =>\n                    setEditingCategory({ ...editingCategory, targetSubfolder: e.target.value })\n                  }\n                  placeholder=\"e.g. Invoices\"\n                  className=\"w-full font-mono bg-white border border-[#cbc6b4] focus:border-[#177a4c] focus:outline-none rounded-lg px-3 py-1.5 text-[#211f19]\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block font-bold text-[#5c584c] mb-1\">\n                  Color Accent\n                </label>\n\n                <div className=\"flex items-center gap-2\">\n                  <input\n                    type=\"color\"\n                    value={editingCategory.color || \'#3b82f6\'}\n                    onChange={(e) =>\n                      setEditingCategory({ ...editingCategory, color: e.target.value })\n                    }\n                    className=\"w-8 h-8 rounded border border-[#cbc6b4] cursor-pointer p-0.5\"\n                  />\n                  <input\n                    type=\"text\"\n                    value={editingCategory.color || \'#3b82f6\'}\n                    onChange={(e) =>\n                      setEditingCategory({ ...editingCategory, color: e.target.value })\n                    }\n                    className=\"font-mono text-xs border border-[#cbc6b4] rounded px-2 py-1 text-[#211f19] w-28\"\n                  />\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block font-bold text-[#5c584c] mb-1\">\n                  AI Prompt Description Hint\n                </label>\n                <textarea\n                  rows={3}\n                  value={editingCategory.description || \'\'}\n                  onChange={(e) =>\n                    setEditingCategory({ ...editingCategory, description: e.target.value })\n                  }\n                  placeholder=\"Explain what kind of files should go here (e.g. PDFs containing invoices, billing statements, tax receipts)\342\200\246\"\n                  className=\"w-full text-xs bg-white border border-[#cbc6b4] focus:border-[#177a4c] focus:outline-none rounded-lg p-2.5 text-[#211f19]\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block font-bold text-[#5c584c] mb-1\">\n                  Keywords (comma separated)\n                </label>\n                <input\n                  type=\"text\"\n                  value={keywordsInput}\n                  onChange={(e) => setKeywordsInput(e.target.value)}\n                  placeholder=\"invoice, receipt, tax, payment, bill\"\n                  className=\"w-full font-mono bg-white border border-[#cbc6b4] focus:border-[#177a4c] focus:outline-none rounded-lg px-3 py-1.5 text-[#211f19]\"\n                />\n              </div>\n            </div>\n\n            <div className=\"flex justify-end gap-2 mt-2 pt-2 border-t border-[#dcd8c9]\">\n              <button\n                type=\"button\"\n                onClick={() => setIsEditing(false)}\n                className=\"bg-[#efede4] text-[#211f19] font-bold text-xs py-1.5 px-3 rounded-lg border border-[#cbc6b4]\"\n              >\n                Cancel\n              </button>\n              <button\n                type=\"submit\"\n                className=\"bg-[#177a4c] hover:bg-[#0e5c38] text-white font-bold text-xs py-1.5 px-4 rounded-lg shadow-sm flex items-center gap-1.5\"\n              >\n                <Check className=\"w-4 h-4\" />\n                <span>Save Category Rule</span>\n              </button>\n            </div>\n          </form>\n        </div>\n      )}\n    </div>\n  );"
      replacement_content: "  return (\n    <div className=\"flex flex-col gap-5 p-6 overflow-y-auto max-h-[calc(100vh-120px)] font-sans text-slate-200\">\n      {/* Header */}\n      <div className=\"flex items-baseline justify-between\">\n        <div>\n          <h2 className=\"text-3xl font-light tracking-tight text-white mb-1\">\n            Sorting Rules & Target Categories\n          </h2>\n          <p className=\"text-xs text-slate-400\">\n            Configure subfolders, keywords, and description hints provided to Ollama / Gemini AI prompt contexts.\n          </p>\n        </div>\n\n        <button\n          onClick={handleCreate}\n          className=\"bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs py-2 px-4 rounded-xl transition-all shadow-lg shadow-indigo-600/20 flex items-center gap-1.5\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>New Category Rule</span>\n        </button>\n      </div>\n\n      {/* Rules Grid */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n        {categories.map((c) => (\n          <div\n            key={c.id}\n            className=\"border border-white/10 bg-white/5 rounded-2xl p-5 shadow-lg backdrop-blur-sm flex flex-col justify-between transition-all hover:bg-white/10\"\n            style={{ borderLeftWidth: \'5px\', borderLeftColor: c.color }}\n          >\n            <div>\n              <div className=\"flex justify-between items-start\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"w-3 h-3 rounded-full\" style={{ backgroundColor: c.color }} />\n                  <h3 className=\"font-display font-bold text-base text-white\">{c.name}</h3>\n                </div>\n\n                <div className=\"flex items-center gap-1\">\n                  <button\n                    onClick={() => handleEdit(c)}\n                    className=\"p-1.5 rounded-lg hover:bg-white/10 text-slate-400 hover:text-white transition-colors\"\n                    title=\"Edit Rule\"\n                  >\n                    <Edit2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                  <button\n                    onClick={() => onDeleteCategory(c.id)}\n                    className=\"p-1.5 rounded-lg hover:bg-rose-500/20 text-rose-400 hover:text-rose-300 transition-colors\"\n                    title=\"Delete Category\"\n                  >\n                    <Trash2 className=\"w-3.5 h-3.5\" />\n                  </button>\n                </div>\n              </div>\n\n              <div className=\"mt-2 text-xs font-mono text-indigo-300\">\n                Subfolder: <code className=\"bg-white/5 border border-white/10 px-2 py-0.5 rounded-md text-white\">/{c.targetSubfolder}</code>\n              </div>\n\n              <p className=\"text-xs text-slate-300 my-3 leading-relaxed\">\n                {c.description || \'No prompt description hint specified.\'}\n              </p>\n\n              {/* Keyword Badges */}\n              <div className=\"flex flex-wrap gap-1.5 mt-2\">\n                {c.keywords.map((k, idx) => (\n                  <span\n                    key={idx}\n                    className=\"font-mono text-[10.5px] bg-white/5 text-slate-300 border border-white/10 px-2.5 py-0.5 rounded-full\"\n                  >\n                    #{k}\n                  </span>\n                ))}\n              </div>\n            </div>\n\n            <div className=\"mt-4 pt-3 border-t border-white/5 flex items-center justify-between text-[10.5px] font-mono text-slate-400\">\n              <span>Rule ID: {c.id}</span>\n              <span className=\"text-emerald-400\">\342\227\217 Prompt Active</span>\n            </div>\n          </div>\n        ))}\n      </div>\n\n      {/* Edit / Create Rule Modal */}\n      {isEditing && (\n        <div className=\"fixed inset-0 bg-black/80 backdrop-blur-md z-50 flex items-center justify-center p-4\">\n          <form\n            onSubmit={handleSave}\n            className=\"bg-[#0c0d0e]/95 border border-white/10 rounded-2xl p-6 max-w-lg w-full shadow-2xl flex flex-col gap-4 text-slate-200\"\n          >\n            <div className=\"flex justify-between items-center pb-3 border-b border-white/10\">\n              <h3 className=\"font-display font-bold text-base text-white\">\n                {editingCategory.id ? \'Edit Category Rule\' : \'Create Category Rule\'}\n              </h3>\n              <button\n                type=\"button\"\n                onClick={() => setIsEditing(false)}\n                className=\"text-slate-400 hover:text-white font-bold\"\n              >\n                \342\234\225\n              </button>\n            </div>\n\n            <div className=\"space-y-4 text-xs font-sans\">\n              <div>\n                <label className=\"block font-bold text-slate-300 mb-1\">\n                  Category Name\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  value={editingCategory.name || \'\'}\n                  onChange={(e) =>\n                    setEditingCategory({ ...editingCategory, name: e.target.value })\n                  }\n                  placeholder=\"e.g. Invoices & Receipts\"\n                  className=\"w-full font-mono bg-white/5 border border-white/10 focus:border-indigo-500/50 focus:bg-white/10 focus:outline-none rounded-xl px-3 py-2 text-white placeholder-slate-500\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block font-bold text-slate-300 mb-1\">\n                  Target Subfolder Name\n                </label>\n                <input\n                  type=\"text\"\n                  required\n                  value={editingCategory.targetSubfolder || \'\'}\n                  onChange={(e) =>\n                    setEditingCategory({ ...editingCategory, targetSubfolder: e.target.value })\n                  }\n                  placeholder=\"e.g. Invoices\"\n                  className=\"w-full font-mono bg-white/5 border border-white/10 focus:border-indigo-500/50 focus:bg-white/10 focus:outline-none rounded-xl px-3 py-2 text-white placeholder-slate-500\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block font-bold text-slate-300 mb-1\">\n                  Color Accent\n                </label>\n\n                <div className=\"flex items-center gap-2\">\n                  <input\n                    type=\"color\"\n                    value={editingCategory.color || \'#3b82f6\'}\n                    onChange={(e) =>\n                      setEditingCategory({ ...editingCategory, color: e.target.value })\n                    }\n                    className=\"w-9 h-9 rounded-xl border border-white/10 bg-transparent cursor-pointer p-0.5\"\n                  />\n                  <input\n                    type=\"text\"\n                    value={editingCategory.color || \'#3b82f6\'}\n                    onChange={(e) =>\n                      setEditingCategory({ ...editingCategory, color: e.target.value })\n                    }\n                    className=\"font-mono text-xs bg-white/5 border border-white/10 focus:border-indigo-500/50 focus:outline-none rounded-xl px-3 py-2 text-white w-28\"\n                  />\n                </div>\n              </div>\n\n              <div>\n                <label className=\"block font-bold text-slate-300 mb-1\">\n                  AI Prompt Description Hint\n                </label>\n                <textarea\n                  rows={3}\n                  value={editingCategory.description || \'\'}\n                  onChange={(e) =>\n                    setEditingCategory({ ...editingCategory, description: e.target.value })\n                  }\n                  placeholder=\"Explain what kind of files should go here (e.g. PDFs containing invoices, billing statements, tax receipts)\342\200\246\"\n                  className=\"w-full text-xs bg-white/5 border border-white/10 focus:border-indigo-500/50 focus:bg-white/10 focus:outline-none rounded-xl p-3 text-white placeholder-slate-500\"\n                />\n              </div>\n\n              <div>\n                <label className=\"block font-bold text-slate-300 mb-1\">\n                  Keywords (comma separated)\n                </label>\n                <input\n                  type=\"text\"\n                  value={keywordsInput}\n                  onChange={(e) => setKeywordsInput(e.target.value)}\n                  placeholder=\"invoice, receipt, tax, payment, bill\"\n                  className=\"w-full font-mono bg-white/5 border border-white/10 focus:border-indigo-500/50 focus:bg-white/10 focus:outline-none rounded-xl px-3 py-2 text-white placeholder-slate-500\"\n                />\n              </div>\n            </div>\n\n            <div className=\"flex justify-end gap-2.5 mt-3 pt-3 border-t border-white/10\">\n              <button\n                type=\"button\"\n                onClick={() => setIsEditing(false)}\n                className=\"bg-white/10 hover:bg-white/15 text-white font-bold text-xs py-2 px-4 rounded-xl border border-white/10 transition-all\"\n              >\n                Cancel\n              </button>\n              <button\n                type=\"submit\"\n                className=\"bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs py-2 px-5 rounded-xl shadow-lg shadow-indigo-600/20 transition-all flex items-center gap-1.5\"\n              >\n                <Check className=\"w-4 h-4\" />\n                <span>Save Category Rule</span>\n              </button>\n            </div>\n          </form>\n        </div>\n      )}\n    </div>\n  );"
