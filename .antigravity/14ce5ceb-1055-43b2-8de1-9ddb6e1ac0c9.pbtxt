    replacement_chunks {
      target_content: "  return (\n    <div className=\"flex flex-col gap-4 p-4 overflow-y-auto max-h-[calc(100vh-120px)] font-sans max-w-5xl\">\n      {/* Header */}\n      <div>\n        <h2 className=\"font-display text-2xl font-extrabold text-[#211f19] tracking-tight\">\n          System Settings & Connections\n        </h2>\n        <p className=\"text-xs text-[#5c584c] mt-0.5\">\n          Configure local Ollama connection, Gemini AI fallback, watch behavior, OS file permissions, and storage persistence.\n        </p>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-4\">\n        {/* 1. Ollama Connection Card */}\n        <div className=\"bg-white border border-[#dcd8c9] rounded-xl p-4 shadow-sm space-y-3\">\n          <div className=\"flex items-center gap-2 border-b border-[#f4f2ea] pb-2\">\n            <Cpu className=\"w-4 h-4 text-[#177a4c]\" />\n            <h3 className=\"font-bold text-xs uppercase tracking-wider text-[#5c584c]\">\n              Ollama Local Connection\n            </h3>\n          </div>\n\n          <div className=\"space-y-2.5 text-xs font-mono\">\n            <div>\n              <label className=\"block text-[10px] uppercase font-bold text-[#8b8676] mb-1\">\n                Endpoint URL\n              </label>\n              <input\n                type=\"text\"\n                value={settings.endpoint}\n                onChange={(e) => handleChange(\'endpoint\', e.target.value)}\n                className=\"w-full bg-[#efede4] focus:bg-white border border-[#cbc6b4] focus:border-[#177a4c] focus:outline-none rounded-lg p-2 text-[#211f19]\"\n              />\n            </div>\n\n            <div>\n              <div className=\"flex justify-between text-[10px] uppercase font-bold text-[#8b8676] mb-1\">\n                <span>Temperature</span>\n                <span className=\"text-[#177a4c] font-bold\">{settings.temperature}</span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"0\"\n                max=\"1\"\n                step=\"0.05\"\n                value={settings.temperature}\n                onChange={(e) => handleChange(\'temperature\', parseFloat(e.target.value))}\n                className=\"w-full accent-[#177a4c]\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[10px] uppercase font-bold text-[#8b8676] mb-1\">\n                Request Timeout (ms)\n              </label>\n              <input\n                type=\"number\"\n                value={settings.timeoutMs}\n                onChange={(e) => handleChange(\'timeoutMs\', parseInt(e.target.value) || 8000)}\n                className=\"w-full bg-[#efede4] focus:bg-white border border-[#cbc6b4] focus:border-[#177a4c] focus:outline-none rounded-lg p-2 text-[#211f19]\"\n              />\n            </div>\n\n            <div className=\"pt-2 border-t border-[#f4f2ea] space-y-2\">\n              <label className=\"flex items-center gap-2 cursor-pointer font-sans text-xs font-semibold text-[#211f19]\">\n                <input\n                  type=\"checkbox\"\n                  checked={settings.useOllama}\n                  onChange={(e) => handleChange(\'useOllama\', e.target.checked)}\n                  className=\"accent-[#177a4c] w-4 h-4 rounded\"\n                />\n                <span>Try Ollama first for AI sorting</span>\n              </label>\n\n              <label className=\"flex items-center gap-2 cursor-pointer font-sans text-xs font-semibold text-[#211f19]\">\n                <input\n                  type=\"checkbox\"\n                  checked={settings.useGeminiFallback}\n                  onChange={(e) => handleChange(\'useGeminiFallback\', e.target.checked)}\n                  className=\"accent-[#177a4c] w-4 h-4 rounded\"\n                />\n                <span>Fallback to Gemini API when Ollama is offline</span>\n              </label>\n            </div>\n\n            <button\n              onClick={onTestOllama}\n              className=\"mt-2 w-full bg-[#177a4c] hover:bg-[#0e5c38] text-white font-bold text-xs py-2 px-3 rounded-lg transition-all flex items-center justify-center gap-1.5 shadow-sm\"\n            >\n              <RefreshCw className=\"w-3.5 h-3.5\" />\n              <span>Test Ollama & Refresh Models</span>\n            </button>\n          </div>\n        </div>\n\n        {/* 2. Gemini API & Server AI Card */}\n        <div className=\"bg-white border border-[#dcd8c9] rounded-xl p-4 shadow-sm space-y-3\">\n          <div className=\"flex items-center gap-2 border-b border-[#f4f2ea] pb-2\">\n            <Sparkles className=\"w-4 h-4 text-[#33719f]\" />\n            <h3 className=\"font-bold text-xs uppercase tracking-wider text-[#5c584c]\">\n              Server Gemini AI Engine\n            </h3>\n          </div>\n\n          <div className=\"space-y-2 text-xs font-mono\">\n            <div className=\"p-3 bg-sky-50 border border-sky-200 rounded-xl flex items-center justify-between\">\n              <div>\n                <div className=\"font-bold text-[#33719f]\">Gemini API Status</div>\n                <div className=\"text-[10.5px] text-[#5c584c]\">\n                  {hasGeminiKey ? \'GEMINI_API_KEY injected & active\' : \'No API Key configured\'}\n                </div>\n              </div>\n              <span className={`font-bold text-[10px] px-2 py-0.5 rounded-full ${hasGeminiKey ? \'bg-emerald-100 text-[#0e5c38]\' : \'bg-amber-100 text-[#8a5d13]\'}`}>\n                {hasGeminiKey ? \'Active\' : \'Offline\'}\n              </span>\n            </div>\n\n            <p className=\"font-sans text-xs text-[#5c584c] leading-relaxed\">\n              When enabled, Sift routes classification tasks through Gemini 2.5 Flash on the server whenever local Ollama is offline or experiencing heavy load.\n            </p>\n          </div>\n        </div>\n\n        {/* 3. Watcher Behavior Card */}\n        <div className=\"bg-white border border-[#dcd8c9] rounded-xl p-4 shadow-sm space-y-3\">\n          <div className=\"flex items-center gap-2 border-b border-[#f4f2ea] pb-2\">\n            <Eye className=\"w-4 h-4 text-[#c08427]\" />\n            <h3 className=\"font-bold text-xs uppercase tracking-wider text-[#5c584c]\">\n              Watcher & Monitor Parameters\n            </h3>\n          </div>\n\n          <div className=\"space-y-3 text-xs font-mono\">\n            <div>\n              <label className=\"block text-[10px] uppercase font-bold text-[#8b8676] mb-1\">\n                Default Sorting Mode\n              </label>\n              <div className=\"flex gap-2\">\n                <button\n                  onClick={() => handleChange(\'defaultMode\', \'auto\')}\n                  className={`flex-1 py-1.5 rounded-lg border font-bold text-xs ${\n                    settings.defaultMode === \'auto\'\n                      ? \'bg-[#177a4c] text-white border-[#0e5c38]\'\n                      : \'bg-[#efede4] text-[#5c584c] border-[#cbc6b4]\'\n                  }`}\n                >\n                  Auto-Sort\n                </button>\n                <button\n                  onClick={() => handleChange(\'defaultMode\', \'review\')}\n                  className={`flex-1 py-1.5 rounded-lg border font-bold text-xs ${\n                    settings.defaultMode === \'review\'\n                      ? \'bg-[#177a4c] text-white border-[#0e5c38]\'\n                      : \'bg-[#efede4] text-[#5c584c] border-[#cbc6b4]\'\n                  }`}\n                >\n                  Review First\n                </button>\n              </div>\n            </div>\n\n            <div>\n              <div className=\"flex justify-between text-[10px] uppercase font-bold text-[#8b8676] mb-1\">\n                <span>Simulated Pace</span>\n                <span className=\"text-[#c08427] font-bold\">~{settings.pace}s</span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"2\"\n                max=\"20\"\n                step=\"1\"\n                value={settings.pace}\n                onChange={(e) => handleChange(\'pace\', parseInt(e.target.value))}\n                className=\"w-full accent-[#c08427]\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[10px] uppercase font-bold text-[#8b8676] mb-1\">\n                Auto-Sort Delay (ms)\n              </label>\n              <input\n                type=\"number\"\n                value={settings.autoDelay}\n                onChange={(e) => handleChange(\'autoDelay\', parseInt(e.target.value) || 0)}\n                className=\"w-full bg-[#efede4] focus:bg-white border border-[#cbc6b4] focus:border-[#177a4c] focus:outline-none rounded-lg p-2 text-[#211f19]\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[10px] uppercase font-bold text-[#8b8676] mb-1\">\n                FS Monitoring API\n              </label>\n              <select\n                value={settings.watchMethod}\n                onChange={(e) => handleChange(\'watchMethod\', e.target.value as any)}\n                className=\"w-full bg-[#efede4] focus:bg-white border border-[#cbc6b4] focus:border-[#177a4c] focus:outline-none rounded-lg p-2 text-[#211f19] font-bold\"\n              >\n                <option value=\"fsevents\">OS Native (FSEvents / ReadDirectoryChangesW / inotify)</option>\n                <option value=\"polling\">Polling Fallback Interval</option>\n              </select>\n            </div>\n          </div>\n        </div>\n\n        {/* 4. OS Permissions & Storage Card */}\n        <div className=\"bg-white border border-[#dcd8c9] rounded-xl p-4 shadow-sm space-y-3\">\n          <div className=\"flex items-center justify-between border-b border-[#f4f2ea] pb-2\">\n            <div className=\"flex items-center gap-2\">\n              <ShieldCheck className=\"w-4 h-4 text-[#177a4c]\" />\n              <h3 className=\"font-bold text-xs uppercase tracking-wider text-[#5c584c]\">\n                OS Permissions & Storage\n              </h3>\n            </div>\n            <span className=\"font-mono text-[10px] font-bold bg-[#e7e4d8] text-[#5c584c] px-2 py-0.5 rounded\">\n              {platform.toUpperCase()}\n            </span>\n          </div>\n\n          <div className=\"space-y-2 text-xs font-mono\">\n            {permissions.map((p, idx) => (\n              <div key={idx} className=\"p-2.5 bg-[#efede4] rounded-lg border border-[#cbc6b4] flex items-center justify-between\">\n                <div className=\"min-w-0 flex-1 mr-2\">\n                  <div className=\"font-bold truncate text-[#211f19]\">{p.path}</div>\n                  <div className=\"text-[10px] text-[#8b8676]\">\n                    Scope: <b>{p.scope}</b> ({p.platform})\n                  </div>\n                </div>\n                <button\n                  onClick={() => onRequestPermission(p.path)}\n                  className=\"bg-white hover:bg-emerald-50 text-[#0e5c38] border border-[#177a4c] font-bold text-[10px] px-2.5 py-1 rounded\"\n                >\n                  Granted \342\234\223\n                </button>\n              </div>\n            ))}\n\n            <div className=\"pt-3 border-t border-[#f4f2ea] mt-3\">\n              <div className=\"flex items-center gap-1.5 text-rose-700 font-bold text-xs mb-1\">\n                <AlertTriangle className=\"w-4 h-4\" />\n                <span>Reset Application Storage</span>\n              </div>\n              <p className=\"font-sans text-[11px] text-[#8b8676] mb-2\">\n                Clears saved rules, activity logs, and shelf data, then reinitializes Sift.\n              </p>\n              <button\n                onClick={onResetAll}\n                className=\"bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs py-1.5 px-3 rounded-lg transition-all\"\n              >\n                Reset Sift Database\342\200\246\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );"
      replacement_content: "  return (\n    <div className=\"flex flex-col gap-5 p-6 overflow-y-auto max-h-[calc(100vh-120px)] font-sans max-w-5xl text-slate-200\">\n      {/* Header */}\n      <div>\n        <h2 className=\"text-3xl font-light tracking-tight text-white mb-1\">\n          System Settings & Connections\n        </h2>\n        <p className=\"text-xs text-slate-400\">\n          Configure local Ollama connection, Gemini AI fallback, watch behavior, OS file permissions, and storage persistence.\n        </p>\n      </div>\n\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-5\">\n        {/* 1. Ollama Connection Card */}\n        <div className=\"bg-white/5 border border-white/10 rounded-2xl p-5 shadow-lg backdrop-blur-sm space-y-4\">\n          <div className=\"flex items-center gap-2 border-b border-white/10 pb-3\">\n            <Cpu className=\"w-4 h-4 text-indigo-400\" />\n            <h3 className=\"font-bold text-xs uppercase tracking-widest text-slate-300\">\n              Ollama Local Connection\n            </h3>\n          </div>\n\n          <div className=\"space-y-3 text-xs font-mono\">\n            <div>\n              <label className=\"block text-[10px] uppercase font-bold text-slate-400 mb-1\">\n                Endpoint URL\n              </label>\n              <input\n                type=\"text\"\n                value={settings.endpoint}\n                onChange={(e) => handleChange(\'endpoint\', e.target.value)}\n                className=\"w-full bg-white/5 focus:bg-white/10 border border-white/10 focus:border-indigo-500/50 focus:outline-none rounded-xl p-2.5 text-white\"\n              />\n            </div>\n\n            <div>\n              <div className=\"flex justify-between text-[10px] uppercase font-bold text-slate-400 mb-1\">\n                <span>Temperature</span>\n                <span className=\"text-indigo-400 font-bold\">{settings.temperature}</span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"0\"\n                max=\"1\"\n                step=\"0.05\"\n                value={settings.temperature}\n                onChange={(e) => handleChange(\'temperature\', parseFloat(e.target.value))}\n                className=\"w-full accent-indigo-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[10px] uppercase font-bold text-slate-400 mb-1\">\n                Request Timeout (ms)\n              </label>\n              <input\n                type=\"number\"\n                value={settings.timeoutMs}\n                onChange={(e) => handleChange(\'timeoutMs\', parseInt(e.target.value) || 8000)}\n                className=\"w-full bg-white/5 focus:bg-white/10 border border-white/10 focus:border-indigo-500/50 focus:outline-none rounded-xl p-2.5 text-white\"\n              />\n            </div>\n\n            <div className=\"pt-3 border-t border-white/10 space-y-2.5\">\n              <label className=\"flex items-center gap-2.5 cursor-pointer font-sans text-xs font-semibold text-slate-200\">\n                <input\n                  type=\"checkbox\"\n                  checked={settings.useOllama}\n                  onChange={(e) => handleChange(\'useOllama\', e.target.checked)}\n                  className=\"accent-indigo-500 w-4 h-4 rounded\"\n                />\n                <span>Try Ollama first for AI sorting</span>\n              </label>\n\n              <label className=\"flex items-center gap-2.5 cursor-pointer font-sans text-xs font-semibold text-slate-200\">\n                <input\n                  type=\"checkbox\"\n                  checked={settings.useGeminiFallback}\n                  onChange={(e) => handleChange(\'useGeminiFallback\', e.target.checked)}\n                  className=\"accent-indigo-500 w-4 h-4 rounded\"\n                />\n                <span>Fallback to Gemini API when Ollama is offline</span>\n              </label>\n            </div>\n\n            <button\n              onClick={onTestOllama}\n              className=\"mt-3 w-full bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs py-2.5 px-3 rounded-xl transition-all flex items-center justify-center gap-2 shadow-lg shadow-indigo-600/20\"\n            >\n              <RefreshCw className=\"w-3.5 h-3.5 text-indigo-200\" />\n              <span>Test Ollama & Refresh Models</span>\n            </button>\n          </div>\n        </div>\n\n        {/* 2. Gemini API & Server AI Card */}\n        <div className=\"bg-white/5 border border-white/10 rounded-2xl p-5 shadow-lg backdrop-blur-sm space-y-4\">\n          <div className=\"flex items-center gap-2 border-b border-white/10 pb-3\">\n            <Sparkles className=\"w-4 h-4 text-indigo-400\" />\n            <h3 className=\"font-bold text-xs uppercase tracking-widest text-slate-300\">\n              Server Gemini AI Engine\n            </h3>\n          </div>\n\n          <div className=\"space-y-3 text-xs font-mono\">\n            <div className=\"p-3.5 bg-indigo-500/10 border border-indigo-500/20 rounded-2xl flex items-center justify-between\">\n              <div>\n                <div className=\"font-bold text-indigo-300\">Gemini API Status</div>\n                <div className=\"text-[10.5px] text-slate-400 mt-0.5\">\n                  {hasGeminiKey ? \'GEMINI_API_KEY injected & active\' : \'No API Key configured\'}\n                </div>\n              </div>\n              <span className={`font-bold text-[10px] px-2.5 py-0.5 rounded-full border ${hasGeminiKey ? \'bg-emerald-500/20 text-emerald-300 border-emerald-500/30\' : \'bg-amber-500/20 text-amber-300 border-amber-500/30\'}`}>\n                {hasGeminiKey ? \'Active\' : \'Offline\'}\n              </span>\n            </div>\n\n            <p className=\"font-sans text-xs text-slate-400 leading-relaxed\">\n              When enabled, Sift routes classification tasks through Gemini 2.5 Flash on the server whenever local Ollama is offline or experiencing heavy load.\n            </p>\n          </div>\n        </div>\n\n        {/* 3. Watcher Behavior Card */}\n        <div className=\"bg-white/5 border border-white/10 rounded-2xl p-5 shadow-lg backdrop-blur-sm space-y-4\">\n          <div className=\"flex items-center gap-2 border-b border-white/10 pb-3\">\n            <Eye className=\"w-4 h-4 text-amber-400\" />\n            <h3 className=\"font-bold text-xs uppercase tracking-widest text-slate-300\">\n              Watcher & Monitor Parameters\n            </h3>\n          </div>\n\n          <div className=\"space-y-3.5 text-xs font-mono\">\n            <div>\n              <label className=\"block text-[10px] uppercase font-bold text-slate-400 mb-1\">\n                Default Sorting Mode\n              </label>\n              <div className=\"flex gap-2\">\n                <button\n                  onClick={() => handleChange(\'defaultMode\', \'auto\')}\n                  className={`flex-1 py-2 rounded-xl border font-bold text-xs transition-all ${\n                    settings.defaultMode === \'auto\'\n                      ? \'bg-indigo-600 text-white border-indigo-500/50 shadow-md shadow-indigo-600/20\'\n                      : \'bg-white/5 text-slate-400 border-white/10 hover:text-white\'\n                  }`}\n                >\n                  Auto-Sort\n                </button>\n                <button\n                  onClick={() => handleChange(\'defaultMode\', \'review\')}\n                  className={`flex-1 py-2 rounded-xl border font-bold text-xs transition-all ${\n                    settings.defaultMode === \'review\'\n                      ? \'bg-indigo-600 text-white border-indigo-500/50 shadow-md shadow-indigo-600/20\'\n                      : \'bg-white/5 text-slate-400 border-white/10 hover:text-white\'\n                  }`}\n                >\n                  Review First\n                </button>\n              </div>\n            </div>\n\n            <div>\n              <div className=\"flex justify-between text-[10px] uppercase font-bold text-slate-400 mb-1\">\n                <span>Simulated Pace</span>\n                <span className=\"text-amber-400 font-bold\">~{settings.pace}s</span>\n              </div>\n              <input\n                type=\"range\"\n                min=\"2\"\n                max=\"20\"\n                step=\"1\"\n                value={settings.pace}\n                onChange={(e) => handleChange(\'pace\', parseInt(e.target.value))}\n                className=\"w-full accent-amber-500\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[10px] uppercase font-bold text-slate-400 mb-1\">\n                Auto-Sort Delay (ms)\n              </label>\n              <input\n                type=\"number\"\n                value={settings.autoDelay}\n                onChange={(e) => handleChange(\'autoDelay\', parseInt(e.target.value) || 0)}\n                className=\"w-full bg-white/5 focus:bg-white/10 border border-white/10 focus:border-indigo-500/50 focus:outline-none rounded-xl p-2.5 text-white\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block text-[10px] uppercase font-bold text-slate-400 mb-1\">\n                FS Monitoring API\n              </label>\n              <select\n                value={settings.watchMethod}\n                onChange={(e) => handleChange(\'watchMethod\', e.target.value as any)}\n                className=\"w-full bg-[#0c0d0e] border border-white/10 focus:border-indigo-500/50 focus:outline-none rounded-xl p-2.5 text-white font-bold cursor-pointer\"\n              >\n                <option value=\"fsevents\" className=\"bg-[#0c0d0e]\">OS Native (FSEvents / ReadDirectoryChangesW / inotify)</option>\n                <option value=\"polling\" className=\"bg-[#0c0d0e]\">Polling Fallback Interval</option>\n              </select>\n            </div>\n          </div>\n        </div>\n\n        {/* 4. OS Permissions & Storage Card */}\n        <div className=\"bg-white/5 border border-white/10 rounded-2xl p-5 shadow-lg backdrop-blur-sm space-y-4\">\n          <div className=\"flex items-center justify-between border-b border-white/10 pb-3\">\n            <div className=\"flex items-center gap-2\">\n              <ShieldCheck className=\"w-4 h-4 text-emerald-400\" />\n              <h3 className=\"font-bold text-xs uppercase tracking-widest text-slate-300\">\n                OS Permissions & Storage\n              </h3>\n            </div>\n            <span className=\"font-mono text-[10px] font-bold bg-white/10 text-slate-300 border border-white/10 px-2.5 py-0.5 rounded-md\">\n              {platform.toUpperCase()}\n            </span>\n          </div>\n\n          <div className=\"space-y-2.5 text-xs font-mono\">\n            {permissions.map((p, idx) => (\n              <div key={idx} className=\"p-3 bg-white/5 rounded-xl border border-white/10 flex items-center justify-between\">\n                <div className=\"min-w-0 flex-1 mr-2\">\n                  <div className=\"font-bold truncate text-white\">{p.path}</div>\n                  <div className=\"text-[10px] text-slate-400 mt-0.5\">\n                    Scope: <b className=\"text-indigo-300\">{p.scope}</b> ({p.platform})\n                  </div>\n                </div>\n                <button\n                  onClick={() => onRequestPermission(p.path)}\n                  className=\"bg-emerald-500/20 hover:bg-emerald-500/30 text-emerald-300 border border-emerald-500/30 font-bold text-[10px] px-3 py-1 rounded-lg transition-all\"\n                >\n                  Granted \342\234\223\n                </button>\n              </div>\n            ))}\n\n            <div className=\"pt-4 border-t border-white/10 mt-4\">\n              <div className=\"flex items-center gap-1.5 text-rose-400 font-bold text-xs mb-1\">\n                <AlertTriangle className=\"w-4 h-4\" />\n                <span>Reset Application Storage</span>\n              </div>\n              <p className=\"font-sans text-[11px] text-slate-400 mb-3 leading-relaxed\">\n                Clears saved rules, activity logs, and shelf data, then reinitializes Sift.\n              </p>\n              <button\n                onClick={onResetAll}\n                className=\"bg-rose-600 hover:bg-rose-500 text-white font-bold text-xs py-2 px-4 rounded-xl transition-all shadow-lg shadow-rose-600/20\"\n              >\n                Reset Sift Database\342\200\246\n              </button>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );"
    }
