    instruction: "Apply Frosted Glass theme to RulesView component"
    replacement_infos {
      original_chunk {
        target_content: "  return (\n    <div className=\"flex flex-col gap-4 p-4 overflow-y-auto max-h-[calc(100vh-120px)] font-sans\">\n      {/* Header */}\n      <div>\n        <h2 className=\"font-display text-2xl font-extrabold text-[#211f19] tracking-tight\">\n          Sorting Rules & Taxonomy\n        </h2>\n        <p className=\"text-xs text-[#5c584c] mt-0.5\">\n          Define Source & Target folders, and train Ollama\'s sorting taxonomy with natural language category descriptions.\n        </p>\n      </div>\n\n      {/* Rule Folder Binding Header */}\n      {currentRule && (\n        <div className=\"bg-white border border-[#dcd8c9] rounded-xl p-3.5 shadow-sm flex items-center justify-between gap-4 font-mono text-xs\">\n          <div className=\"flex items-center gap-3\">\n            <FolderCheck className=\"w-5 h-5 text-[#177a4c]\" />\n            <div>\n              <span className=\"font-bold text-[#211f19]\">{currentRule.name}</span>\n              <div className=\"text-[10.5px] text-[#8b8676]\">\n                Source Watch: <b>{currentRule.sourceFolder}</b> \342\236\224 Target Shelf: <b>{currentRule.targetFolder}</b>\n              </div>\n            </div>\n          </div>\n          <span className=\"font-bold text-[10px] bg-[#dcefe2] text-[#0e5c38] px-2.5 py-1 rounded-full uppercase\">\n            Active Rule\n          </span>\n        </div>\n      )}\n\n      {/* Main Grid: Categories List + Prompt Template Editor */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-4\">\n        {/* Category List Editor */}\n        <div className=\"lg:col-span-2 space-y-3\">\n          <div className=\"flex items-center justify-between\">\n            <h3 className=\"font-bold text-xs uppercase tracking-wider text-[#5c584c]\">\n              Taxonomy Categories ({categories.length})\n            </h3>\n            <div className=\"flex gap-2\">\n              <button\n                onClick={handleAddCategory}\n                className=\"bg-[#177a4c] hover:bg-[#0e5c38] text-white font-bold text-xs py-1.5 px-3 rounded-lg transition-all flex items-center gap-1.5 shadow-sm\"\n              >\n                <Plus className=\"w-3.5 h-3.5\" />\n                <span>Add Category</span>\n              </button>\n              <button\n                onClick={onResetRules}\n                className=\"bg-white hover:bg-[#efede4] text-[#5c584c] border border-[#cbc6b4] font-bold text-xs py-1.5 px-3 rounded-lg transition-all flex items-center gap-1.5\"\n              >\n                <RotateCcw className=\"w-3.5 h-3.5\" />\n                <span>Reset Defaults</span>\n              </button>\n            </div>\n          </div>\n\n          <div className=\"space-y-2\">\n            {categories.map((c) => (\n              <div\n                key={c.id}\n                className=\"bg-white border border-[#dcd8c9] hover:border-[#cbc6b4] rounded-xl p-3 shadow-sm grid grid-cols-12 gap-2 items-center\"\n              >\n                {/* Color Picker */}\n                <div className=\"col-span-1 flex justify-center\">\n                  <input\n                    type=\"color\"\n                    value={c.color}\n                    onChange={(e) => handleCategoryChange(c.id, \'color\', e.target.value)}\n                    className=\"w-7 h-7 rounded-lg border-0 cursor-pointer bg-transparent\"\n                    title=\"Category Color\"\n                  />\n                </div>\n\n                {/* Name */}\n                <div className=\"col-span-3\">\n                  <input\n                    type=\"text\"\n                    value={c.name}\n                    onChange={(e) => handleCategoryChange(c.id, \'name\', e.target.value)}\n                    className=\"w-full font-display font-bold text-xs bg-[#efede4] focus:bg-white border border-transparent focus:border-[#177a4c] focus:outline-none rounded-lg px-2 py-1.5 text-[#211f19]\"\n                    placeholder=\"Category Name\"\n                  />\n                </div>\n\n                {/* Description for AI */}\n                <div className=\"col-span-4\">\n                  <input\n                    type=\"text\"\n                    value={c.desc}\n                    onChange={(e) => handleCategoryChange(c.id, \'desc\', e.target.value)}\n                    className=\"w-full font-sans text-xs bg-[#efede4] focus:bg-white border border-transparent focus:border-[#177a4c] focus:outline-none rounded-lg px-2 py-1.5 text-[#211f19]\"\n                    placeholder=\"AI Prompt Description...\"\n                  />\n                </div>\n\n                {/* Extensions */}\n                <div className=\"col-span-3\">\n                  <input\n                    type=\"text\"\n                    value={c.exts}\n                    onChange={(e) => handleCategoryChange(c.id, \'exts\', e.target.value)}\n                    className=\"w-full font-mono text-[11px] bg-[#efede4] focus:bg-white border border-transparent focus:border-[#177a4c] focus:outline-none rounded-lg px-2 py-1.5 text-[#5c584c]\"\n                    placeholder=\"ext1, ext2\"\n                  />\n                </div>\n\n                {/* Delete button */}\n                <div className=\"col-span-1 flex justify-end\">\n                  {c.id !== \'misc\' && (\n                    <button\n                      onClick={() => handleDeleteCategory(c.id)}\n                      className=\"p-1.5 text-[#8b8676] hover:text-rose-600 rounded-lg hover:bg-rose-50 transition-colors\"\n                      title=\"Delete Category\"\n                    >\n                      <Trash2 className=\"w-4 h-4\" />\n                    </button>\n                  )}\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* System Prompt Template Box */}\n        <div className=\"bg-white border border-[#dcd8c9] rounded-xl p-4 shadow-sm flex flex-col gap-3\">\n          <div className=\"flex items-center gap-2\">\n            <Sparkles className=\"w-4 h-4 text-[#177a4c]\" />\n            <h4 className=\"font-bold text-xs uppercase tracking-wider text-[#5c584c]\">\n              System Prompt Template\n            </h4>\n          </div>\n\n          <textarea\n            value={promptTemplate}\n            onChange={(e) => onUpdatePromptTemplate(e.target.value)}\n            spellCheck={false}\n            className=\"w-full h-64 font-mono text-xs bg-[#efede4] focus:bg-white border border-[#cbc6b4] focus:border-[#177a4c] focus:outline-none rounded-xl p-3 text-[#211f19] leading-relaxed resize-y\"\n          />\n\n          <div className=\"text-[11px] text-[#8b8676] leading-normal flex items-start gap-1.5\">\n            <HelpCircle className=\"w-4 h-4 text-[#177a4c] flex-none mt-0.5\" />\n            <span>\n              The token <code>{\'{categories}\'}</code> is dynamically substituted with the list of active categories and descriptions above.\n            </span>\n          </div>\n        </div>\n      </div>\n    </div>\n  );"
        replacement_content: "  return (\n    <div className=\"flex flex-col gap-5 p-6 overflow-y-auto max-h-[calc(100vh-120px)] font-sans text-slate-200\">\n      {/* Header */}\n      <div>\n        <h2 className=\"text-3xl font-light tracking-tight text-white mb-1\">\n          Sorting Rules & Taxonomy\n        </h2>\n        <p className=\"text-xs text-slate-400\">\n          Define Source & Target folders, and train Ollama\'s sorting taxonomy with natural language category descriptions.\n        </p>\n      </div>\n\n      {/* Rule Folder Binding Header */}\n      {currentRule && (\n        <div className=\"bg-white/5 border border-white/10 rounded-2xl p-4 shadow-lg backdrop-blur-sm flex items-center justify-between gap-4 font-mono text-xs\">\n          <div className=\"flex items-center gap-3\">\n            <FolderCheck className=\"w-5 h-5 text-indigo-400\" />\n            <div>\n              <span className=\"font-bold text-white\">{currentRule.name}</span>\n              <div className=\"text-[10.5px] text-slate-400 mt-0.5\">\n                Source Watch: <b className=\"text-amber-400\">{currentRule.sourceFolder}</b> \342\236\224 Target Shelf: <b className=\"text-indigo-400\">{currentRule.targetFolder}</b>\n              </div>\n            </div>\n          </div>\n          <span className=\"font-bold text-[10px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-3 py-1 rounded-full uppercase\">\n            Active Rule\n          </span>\n        </div>\n      )}\n\n      {/* Main Grid: Categories List + Prompt Template Editor */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-5\">\n        {/* Category List Editor */}\n        <div className=\"lg:col-span-2 space-y-3.5\">\n          <div className=\"flex items-center justify-between\">\n            <h3 className=\"font-bold text-xs uppercase tracking-widest text-slate-400\">\n              Taxonomy Categories ({categories.length})\n            </h3>\n            <div className=\"flex gap-2\">\n              <button\n                onClick={handleAddCategory}\n                className=\"bg-indigo-600 hover:bg-indigo-500 text-white font-bold text-xs py-2 px-3.5 rounded-xl transition-all flex items-center gap-1.5 shadow-lg shadow-indigo-600/20\"\n              >\n                <Plus className=\"w-3.5 h-3.5\" />\n                <span>Add Category</span>\n              </button>\n              <button\n                onClick={onResetRules}\n                className=\"bg-white/5 hover:bg-white/10 text-slate-300 border border-white/10 font-bold text-xs py-2 px-3.5 rounded-xl transition-all flex items-center gap-1.5\"\n              >\n                <RotateCcw className=\"w-3.5 h-3.5\" />\n                <span>Reset Defaults</span>\n              </button>\n            </div>\n          </div>\n\n          <div className=\"space-y-2.5\">\n            {categories.map((c) => (\n              <div\n                key={c.id}\n                className=\"bg-white/5 border border-white/10 hover:border-white/20 rounded-2xl p-3.5 shadow-lg backdrop-blur-sm grid grid-cols-12 gap-2.5 items-center\"\n              >\n                {/* Color Picker */}\n                <div className=\"col-span-1 flex justify-center\">\n                  <input\n                    type=\"color\"\n                    value={c.color}\n                    onChange={(e) => handleCategoryChange(c.id, \'color\', e.target.value)}\n                    className=\"w-7 h-7 rounded-lg border-0 cursor-pointer bg-transparent\"\n                    title=\"Category Color\"\n                  />\n                </div>\n\n                {/* Name */}\n                <div className=\"col-span-3\">\n                  <input\n                    type=\"text\"\n                    value={c.name}\n                    onChange={(e) => handleCategoryChange(c.id, \'name\', e.target.value)}\n                    className=\"w-full font-display font-bold text-xs bg-white/5 focus:bg-white/10 border border-white/10 focus:border-indigo-500/50 focus:outline-none rounded-xl px-2.5 py-1.5 text-white\"\n                    placeholder=\"Category Name\"\n                  />\n                </div>\n\n                {/* Description for AI */}\n                <div className=\"col-span-4\">\n                  <input\n                    type=\"text\"\n                    value={c.desc}\n                    onChange={(e) => handleCategoryChange(c.id, \'desc\', e.target.value)}\n                    className=\"w-full font-sans text-xs bg-white/5 focus:bg-white/10 border border-white/10 focus:border-indigo-500/50 focus:outline-none rounded-xl px-2.5 py-1.5 text-slate-200 placeholder-slate-500\"\n                    placeholder=\"AI Prompt Description...\"\n                  />\n                </div>\n\n                {/* Extensions */}\n                <div className=\"col-span-3\">\n                  <input\n                    type=\"text\"\n                    value={c.exts}\n                    onChange={(e) => handleCategoryChange(c.id, \'exts\', e.target.value)}\n                    className=\"w-full font-mono text-[11px] bg-white/5 focus:bg-white/10 border border-white/10 focus:border-indigo-500/50 focus:outline-none rounded-xl px-2.5 py-1.5 text-indigo-300 placeholder-slate-500\"\n                    placeholder=\"ext1, ext2\"\n                  />\n                </div>\n\n                {/* Delete button */}\n                <div className=\"col-span-1 flex justify-end\">\n                  {c.id !== \'misc\' && (\n                    <button\n                      onClick={() => handleDeleteCategory(c.id)}\n                      className=\"p-1.5 text-slate-400 hover:text-rose-400 rounded-lg hover:bg-rose-500/20 transition-colors\"\n                      title=\"Delete Category\"\n                    >\n                      <Trash2 className=\"w-4 h-4\" />\n                    </button>\n                  )}\n                </div>\n              </div>\n            ))}\n          </div>\n        </div>\n\n        {/* System Prompt Template Box */}\n        <div className=\"bg-white/5 border border-white/10 rounded-2xl p-5 shadow-lg backdrop-blur-sm flex flex-col gap-3.5\">\n          <div className=\"flex items-center gap-2\">\n            <Sparkles className=\"w-4 h-4 text-indigo-400\" />\n            <h4 className=\"font-bold text-xs uppercase tracking-widest text-slate-400\">\n              System Prompt Template\n            </h4>\n          </div>\n\n          <textarea\n            value={promptTemplate}\n            onChange={(e) => onUpdatePromptTemplate(e.target.value)}\n            spellCheck={false}\n            className=\"w-full h-64 font-mono text-xs bg-black/40 focus:bg-black/60 border border-white/10 focus:border-indigo-500/50 focus:outline-none rounded-2xl p-3.5 text-slate-200 leading-relaxed resize-y\"\n          />\n\n          <div className=\"text-[11px] text-slate-400 leading-normal flex items-start gap-1.5\">\n            <HelpCircle className=\"w-4 h-4 text-indigo-400 flex-none mt-0.5\" />\n            <span>\n              The token <code className=\"text-indigo-300 bg-white/5 px-1 py-0.5 rounded border border-white/10\">{\'{categories}\'}</code> is dynamically substituted with the list of active categories and descriptions above.\n            </span>\n          </div>\n        </div>\n      </div>\n    </div>\n  );"
