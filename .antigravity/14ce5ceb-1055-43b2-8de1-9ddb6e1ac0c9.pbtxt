      target_content: "    const resp = await fetch(url, fetchOptions);\n    clearTimeout(timeout);\n\n    const data = await resp.json();\n    res.status(resp.status).json(data);\n  } catch (err: any) {\n    res.status(502).json({\n      error: \"Ollama endpoint unreachable\",\n      details: err.message,\n      endpoint,\n    });\n  }\n});\n\n// 3. Gemini AI Server-Side Classification\napp.post(\"/api/gemini/classify\", async (req, res) => {\n  const { fileName, fileContent, fileExt, fileSize, categories, promptTemplate } = req.body;\n\n  const ai = getGeminiClient();\n  if (!ai) {\n    return res.status(400).json({ error: \"Gemini API key is not configured on server\" });\n  }\n\n  const categoryListStr = (categories || DEFAULT_CATEGORIES)\n    .map((c: any) => `- ${c.name}: ${c.desc || c.exts || \'general\'}`)\n    .join(\"\\n\");\n\n  const sysPrompt = (promptTemplate || DEFAULT_PROMPT).replace(\"{categories}\", categoryListStr);\n  const userContent = `File Name: ${fileName}\\nExtension: ${fileExt}\\nSize: ${fileSize} bytes\\nExcerpt Content:\\n${(fileContent || \"\").slice(0, 2000)}`;\n\n  try {\n    const response = await ai.models.generateContent({\n      model: \"gemini-2.5-flash\",\n      contents: userContent,\n      config: {\n        systemInstruction: sysPrompt,\n        responseMimeType: \"application/json\",\n        temperature: db.settings.temperature || 0.2,\n      },\n    });\n\n    const text = response.text || \"{}\";\n    const parsed = JSON.parse(text);\n\n    res.json({\n      category: parsed.category || \"Misc\",\n      confidence: typeof parsed.confidence === \"number\" ? parsed.confidence : 0.85,\n      reason: parsed.reason || \"Analyzed file metadata and content via Gemini\",\n      tokens: response.usageMetadata?.totalTokenCount || 45,\n    });\n  } catch (err: any) {\n    console.error(\"Gemini classification failed:\", err);\n    res.status(500).json({ error: err.message || \"Gemini classification error\" });\n  }\n});\n\n// 4. File operations (Upload, List Watch, List Shelf, Move File, Undo Move)"
