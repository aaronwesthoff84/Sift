items-center text-[10px] font-bold uppercase tracking-wider text-[#8b8676]\">\n            <span>Avg decision</span>\n            <span className=\"text-[#33719f] font-mono\">ms / file</span>\n          </div>\n          <div className=\"font-display text-2xl font-extrabold tracking-tight my-1 text-[#211f19]\">\n            {avgMs}\n          </div>\n          <div className=\"h-2 bg-sky-100 rounded-full overflow-hidden\">\n            <div className=\"h-full bg-[#33719f] transition-all\" style={{ width: \'65%\' }} />\n          </div>\n        </div>\n\n        <div className=\"bg-white border border-[#dcd8c9] rounded-xl p-3 shadow-sm hover:-translate-y-0.5 transition-transform\">\n          <div className=\"flex justify-between items-center text-[10px] font-bold uppercase tracking-wider text-[#8b8676]\">\n            <span>Tokens used</span>\n            <span className=\"text-[#b3543f] font-mono\">ollama/gemini</span>\n          </div>\n          <div className=\"font-display text-2xl font-extrabold tracking-tight my-1 text-[#211f19]\">\n            {totals.tokens.toLocaleString()}\n          </div>\n          <div className=\"h-2 bg-rose-100 rounded-full overflow-hidden\">\n            <div className=\"h-full bg-[#b3543f] transition-all\" style={{ width: \'40%\' }} />\n          </div>\n        </div>\n      </div>\n\n      {/* Main Grid: Left Inbox + Right Decision Engine Console */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-4\">\n        {/* Inbox Panel */}\n        <div className=\"lg:col-span-2 bg-white border border-[#dcd8c9] rounded-xl overflow-hidden flex flex-col min-h-[420px]\">\n          <div className=\"flex items-center justify-between p-3 px-4 bg-gradient-to-b from-white to-[#faf9f4] border-b border-[#dcd8c9]\">\n            <div className=\"flex items-center gap-2\">\n              <h3 className=\"font-bold text-xs uppercase tracking-wider text-[#5c584c]\">Inbox Queue</h3>\n              <span className=\"font-mono text-xs font-bold bg-[#e7e4d8] text-[#5c584c] rounded-md px-2 py-0.5\">\n                {files.length}\n              </span>\n            </div>\n            <span className=\"font-mono text-[10.5px] text-[#8b8676]\">\n              {mode === \'auto\' ? \'mode: auto-sort active\' : \'mode: awaiting review\'}\n            </span>\n          </div>\n\n          <div className=\"p-3 flex-1 overflow-y-auto\">\n            {files.length === 0 ? (\n              <div className=\"m-6 border-2 border-dashed border-[#cbc6b4] rounded-xl p-10 text-center text-[#8b8676] text-xs leading-relaxed\">\n                <FileText className=\"w-8 h-8 mx-auto mb-2 text-[#cbc6b4]\" />\n                <p>Nothing in the inbox queue right now.</p>\n                <p className=\"mt-1 font-semibold text-[#5c584c]\">\n                  Drop files anywhere on this window, or click <b>Simulate File</b> in the top bar.\n                </p>\n              </div>\n            ) : (\n              <div className=\"grid grid-cols-1 md:grid-cols-2 gap-3\">\n                {files.map((f) => {\n                  const decision = f.decision;\n                  const cat = decision ? getCat(decision.catId) : null;\n                  const confPct = decision ? Math.round(decision.confidence * 100) : 0;\n\n                  return (\n                    <div\n                      key={f.id}\n                      className={`border border-[#dcd8c9] rounded-xl p-3 bg-white shadow-sm flex flex-col justify-between transition-all ${\n                        f.status === \'analyzing\'\n                          ? \'bg-gradient-to-r from-white via-emerald-50/50 to-white animate-pulse border-emerald-300\'\n                          : \'\'\n                      }`}\n                      style={{ borderColor: cat ? `${cat.color}66` : undefined }}\n                    >\n                      <div>\n                        <div className=\"flex items-center gap-2.5\">\n                          <div\n                            className=\"w-10 h-10 rounded-lg flex-none flex items-center justify-center font-mono font-bold text-xs uppercase text-white shadow-inner\"\n                            style={{ backgroundColor: cat ? cat.color : \'#8b8676\' }}\n                          >\n                            {f.ext || \'??\'}\n                          </div>\n                          <div className=\"min-w-0 flex-1\">\n                            <div className=\"font-mono text-xs font-semibold truncate text-[#211f19]\" title={f.name}>\n                              {f.name}\n                            </div>\n                            <div className=\"font-mono text-[10px] text-[#8b8676] mt-0.5\">\n                              {fmtSize(f.size)} \302\267 {nowT().slice(0, 5)}\n                            </div>\n                          </div>\n                        </div>\n\n                        {/* Status / Verdict Section */}\n                        <div className=\"mt-3 pt-2 border-t border-[#f4f2ea]\">\n                          {f.status === \'queued\' && (\n                            <span className=\"inline-block font-mono text-[10px] font-medium bg-[#efede4] text-[#8b8676] border border-dashed border-[#cbc6b4] rounded-full px-2.5 py-0.5\">\n                              queued in buffer\342\200\246\n                            </span>\n                          )}\n\n                          {f.status === \'analyzing\' && (\n                            <div className=\"flex items-center gap-1.5 font-mono text-[10.5px] font-semibold text-[#0e5c38]\">\n                              <Zap className=\"w-3.5 h-3.5 animate-spin text-emerald-600\" />\n                              <span>Analyzing content & metadata\342\200\246</span>\n                            </div>\n                          )}\n\n                          {decision && cat && (\n                            <div>\n                              <div className=\"flex items-center justify-between text-xs\">\n                                <span\n                                  className=\"font-bold text-[11px] px-2.5 py-0.5 rounded-full border\"\n                                  style={{\n                                    color: cat.color,\n                                    backgroundColor: `${cat.color}15`,\n                                    borderColor: `${cat.color}40`,\n                                  }}\n                                >\n                                  {cat.name}\n                                </span>\n                                <span className=\"font-mono text-xs font-bold text-[#5c584c]\">\n                                  {confPct}% confidence\n                                </span>\n                              </div>\n\n                              {/* Confidence Bar */}\n                              <div className=\"w-full h-1 bg-[#e7e4d8] rounded-full mt-2 overflow-hidden\">\n                                <div\n                                  className=\"h-full rounded-full transition-all duration-500\"\n                                  style={{\n                                    width: `${confPct}%`,\n                                    backgroundColor: cat.color,\n                                  }}\n                                />\n                              </div>\n\n                              <p className=\"text-[11px] text-[#5c584c] italic mt-1.5 line-clamp-2\">\n                                {decision.reason}\n                              </p>\n                            </div>\n                          )}\n                        </div>\n                      </div>\n\n                      {/* Review Mode Action Buttons */}\n                      {f.status === \'review\' && decision && (\n                        <div className=\"flex gap-2 mt-3 pt-2 border-t border-[#f4f2ea]\">\n                          <button\n                            onClick={() => onApproveFile(f)}\n                            className=\"flex-1 bg-[#177a4c] hover:bg-[#0e5c38] text-white font-bold text-xs py-1.5 px-2 rounded-lg transition-all flex items-center justify-center gap-1 shadow-sm\"\n                          >\n                            <Check className=\"w-3.5 h-3.5\" />\n                            <span>Sort \342\234\223</span>\n                          </button>\n                          <button\n                            onClick={() => onSkipFile(f)}\n                            className=\"bg-white hover:bg-rose-50 hover:text-rose-600 text-[#5c584c] border border-[#cbc6b4] font-bold text-xs py-1.5 px-3 rounded-lg transition-all flex items-center justify-center gap-1\"\n                          >\n                            <X className=\"w-3.5 h-3.5\" />\n                            <span>Skip</span>\n                          </button>\n                        </div>\n                      )}\n                    </div>\n                  );\n                })}\n              </div>\n            )}\n          </div>\n        </div>\n\n        {/* Right Console & Recent Decisions Rail */}\n        <div className=\"flex flex-col gap-4\">\n          {/* Real-time Decision Engine Console */}\n          <div className=\"bg-[#0f1613] text-[#9db3a4] border border-[#1e2a23] rounded-xl overflow-hidden flex flex-col h-[280px] shadow-lg font-mono text-xs\">\n            <div className=\"flex items-center justify-between p-2.5 px-3 bg-[#15211b] border-b border-[#1e2a23]\">\n              <div className=\"flex items-center gap-2\">\n                <Terminal className=\"w-3.5 h-3.5 text-emerald-400\" />\n                <span className=\"font-bold uppercase tracking-wider text-[10px] text-emerald-300\">\n                  Decision Engine Log\n                </span>\n              </div>\n              <button\n                onClick={onClearConsole}\n                className=\"text-[10px] font-semibold text-[#8fa89a] hover:text-white px-2 py-0.5 rounded border border-[#2a382f] bg-[#0f1613]\"\n              >\n                Clear\n              </button>\n            </div>\n\n            <div className=\"p-3 overflow-y-auto flex-1 space-y-1.5 leading-relaxed\">\n              {consoleLogs.map((log) => (\n                <div key={log.id} className=\"text-[11px] break-words\">\n                  <span className=\"text-[#4d6355] mr-2\">{log.t}</span>\n                  <span\n                    dangerouslySetInnerHTML={{ __html: log.text }}\n                    className={\n                      log.cls === \'ok\'\n                        ? \'text-emerald-400 font-semibold\'\n                        : log.cls === \'err\'\n                        ? \'text-rose-400\'\n                        : log.cls === \'oll\'\n                        ? \'text-teal-300\'\n                        : \'text-[#8fa89a]\'\n                    }\n                  />\n                </div>\n              ))}\n              <div ref={consoleEndRef} />\n            </div>\n          </div>\n\n          {/* Recent Decisions List */}\n          <div className=\"bg-white border border-[#dcd8c9] rounded-xl p-3 shadow-sm flex flex-col\">\n            <div className=\"flex items-center gap-2 pb-2 border-b border-[#f4f2ea]\">\n              <Clock className=\"w-3.5 h-3.5 text-[#8b8676]\" />\n              <h4 className=\"font-bold text-xs uppercase tracking-wider text-[#5c584c]\">\n                Recent Decisions\n              </h4>\n            </div>\n\n            <ul className=\"mt-2 space-y-1.5 max-h-[140px] overflow-y-auto\">\n              {recentDecisions.length === 0 ? (\n                <li className=\"text-xs text-[#8b8676] py-2 italic text-center\">\n                  No decisions logged yet\342\200\246\n                </li>\n              ) : (\n                recentDecisions.map((r) => (\n                  <li\n                    key={r.id}\n                    className=\"flex items-center gap-2 text-xs p-1.5 rounded-lg hover:bg-[#efede4] transition-colors\"\n                  >\n                    <span\n                      className=\"w-2 h-2 rounded-full flex-none\"\n                      style={{ backgroundColor: r.color }}\n                    />\n                    <span className=\"font-mono text-[11px] font-medium truncate flex-1 text-[#211f19]\">\n                      {r.name}\n                    </span>\n                    <span\n                      className=\"font-bold text-[10px] px-2 py-0.5 rounded-full\"\n                      style={{\n                        backgroundColor: `${r.color}20`,\n                        color: r.color,\n                      }}\n                    >\n                      {r.catName}\n                    </span>\n                    <span className=\"font-mono text-[9.5px] text-[#8b8676]\">{r.t}</span>\n                  </li>\n                ))\n              )}\n            </ul>\n          </div>\n        </div>\n      </div>\n    </div>\n  );"
