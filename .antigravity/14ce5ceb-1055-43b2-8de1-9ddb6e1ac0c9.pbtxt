      replacement_content: "import React, { useState, useEffect, useRef } from \'react\';\nimport {\n  Platform,\n  SortingMode,\n  SortingFile,\n  Category,\n  Rule,\n  Settings,\n  OllamaStatus,\n  ActivityLogEntry,\n  Decision,\n} from \'./types\';\nimport { extOf, randSize, fmtSize, nowT, heuristicClassify } from \'./utils/helpers\';\nimport { TopBar } from \'./components/TopBar\';\nimport { Sidebar } from \'./components/Sidebar\';\nimport { WatchView } from \'./components/WatchView\';\nimport { ShelfView } from \'./components/ShelfView\';\nimport { RulesView } from \'./components/RulesView\';\nimport { ActivityView } from \'./components/ActivityView\';\nimport { SettingsView } from \'./components/SettingsView\';\nimport { PermissionModal } from \'./components/PermissionModal\';\n\nconst DEFAULT_CATEGORIES: Category[] = [\n  { id: \'documents\', name: \'Documents\', color: \'#2f6fdb\', desc: \'Reports, invoices, PDFs, contracts, notes, prose\', exts: \'pdf,doc,docx,txt,md,rtf,pages,tex,epub\', kw: [\'invoice\', \'report\', \'contract\', \'notes\', \'resume\', \'letter\'], targetSubfolder: \'Documents\' },\n  { id: \'images\', name: \'Images\', color: \'#d6488f\', desc: \'Photos, screenshots, illustrations, graphic assets\', exts: \'jpg,jpeg,png,heic,gif,webp,svg,tiff,bmp,avif\', kw: [\'screenshot\', \'photo\', \'img\', \'picture\', \'wallpaper\', \'scan\'], targetSubfolder: \'Images\' },\n  { id: \'code\', name: \'Code\', color: \'#178a54\', desc: \'Source files, scripts, configurations, notebooks\', exts: \'js,ts,jsx,tsx,py,swift,rs,go,c,cpp,h,rb,sh,html,css,sql,json,ipynb\', kw: [\'script\', \'main\', \'index\', \'server\', \'utils\', \'app\'], targetSubfolder: \'Code\' },\n  { id: \'media\', name: \'Audio & Video\', color: \'#d98a1f\', desc: \'Video clips, audio recordings, music, podcasts\', exts: \'mp4,mov,mkv,avi,mp3,wav,flac,aac,m4a,ogg,webm,aiff\', kw: [\'podcast\', \'recording\', \'clip\', \'track\', \'mix\', \'video\'], targetSubfolder: \'Media\' },\n  { id: \'archives\', name: \'Archives\', color: \'#7a5ad0\', desc: \'Compressed bundles, disk images, installers\', exts: \'zip,rar,7z,tar,gz,dmg,iso,pkg,bz2\', kw: [\'backup\', \'bundle\', \'release\', \'installer\'], targetSubfolder: \'Archives\' },\n  { id: \'data\', name: \'Data\', color: \'#0e93a8\', desc: \'Datasets, spreadsheets, analytics exports, database dumps\', exts: \'csv,xlsx,xls,parquet,tsv,db,sqlite,yaml,yml,xml\', kw: [\'dataset\', \'export\', \'metrics\', \'analytics\', \'budget\'], targetSubfolder: \'Data\' },\n  { id: \'design\', name: \'Design\', color: \'#e05252\', desc: \'Design mockups, vector artwork, 3D models\', exts: \'fig,sketch,psd,ai,xd,blend,obj,stl\', kw: [\'mockup\', \'wireframe\', \'logo\', \'brand\', \'prototype\'], targetSubfolder: \'Design\' },\n  { id: \'misc\', name: \'Everything else\', color: \'#6b7280\', desc: \'Fallback category for uncategorized files\', exts: \'\', kw: [], targetSubfolder: \'Misc\' },\n];\n\nconst DEFAULT_MODELS = [\'llama3.2\', \'llama3.1\', \'mistral\', \'phi3.5\', \'qwen2.5\', \'gemma2\'];\n\nexport default function App() {\n  const [platform, setPlatform] = useState<Platform>(\'macos\');\n  const [activeTab, setActiveTab] = useState<string>(\'watch\');\n  const [watching, setWatching] = useState<boolean>(true);\n  const [watchPath, setWatchPath] = useState<string>(\'~/Downloads\');\n  const [shelfPath, setShelfPath] = useState<string>(\'~/Documents/Shelf\');\n  const [mode, setMode] = useState<SortingMode>(\'auto\');\n\n  const [models, setModels] = useState<string[]>(DEFAULT_MODELS);\n  const [selectedModel, setSelectedModel] = useState<string>(\'llama3.2\');\n\n  const [files, setFiles] = useState<SortingFile[]>([]);\n  const [categories, setCategories] = useState<Category[]>(DEFAULT_CATEGORIES);\n  const [rules, setRules] = useState<Rule[]>([]);\n  const [activityLog, setActivityLog] = useState<ActivityLogEntry[]>([]);\n  const [shelfData, setShelfData] = useState<Record<string, any[]>>({});\n\n  const [settings, setSettings] = useState<Settings>({\n    endpoint: \'http://localhost:11434\',\n    model: \'llama3.2\',\n    temperature: 0.2,\n    timeoutMs: 8000,\n    useOllama: true,\n    useGeminiFallback: true,\n    pace: 6,\n    autoDelay: 900,\n    promptTemplate: `You are Sift, an AI file-sorting engine. Classify the incoming file into exactly one category.\\nRespond with JSON: {\"category\":\"<category name>\",\"confidence\":<0..1>,\"reason\":\"<max 12 words>\"}\\nCategories:\\n{categories}`,\n    defaultMode: \'auto\',\n    watchMethod: \'fsevents\',\n    pollIntervalMs: 2000,\n  });\n\n  const [ollamaStatus, setOllamaStatus] = useState<OllamaStatus>({\n    connected: null,\n    latencyMs: null,\n    availableModels: DEFAULT_MODELS,\n  });\n\n  const [hasGeminiKey, setHasGeminiKey] = useState<boolean>(false);\n  const [selectedCatId, setSelectedCatId] = useState<string>(\'documents\');\n\n  const [totals, setTotals] = useState({ sorted: 0, tokens: 0 });\n  const [histMs, setHistMs] = useState<number[]>([320, 280, 410, 350]);\n\n  const [consoleLogs, setConsoleLogs] = useState<Array<{ id: string; t: string; text: string; cls: string }>>([\n    { id: \'1\', t: nowT(), text: \'\342\227\206 Sift v1.2.0 initialized \342\200\224 desktop folder autopilot armed\', cls: \'ok\' },\n  ]);\n\n  const [recentDecisions, setRecentDecisions] = useState<Array<{ id: string; name: string; catName: string; color: string; t: string }>>([]);\n\n  const [permissionModal, setPermissionModal] = useState<{ isOpen: boolean; path: string }>({\n    isOpen: false,\n    path: \'\',\n  });\n\n  const [isDropOver, setIsDropOver] = useState<boolean>(false);\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  // Helper log function\n  const addConsoleLog = (text: string, cls: string = \'sys\') => {\n    setConsoleLogs((prev) => [\n      ...prev.slice(-120),\n      { id: `${Date.now()}-${Math.random()}`, t: nowT(), text, cls },\n    ]);\n  };\n\n  // 1. Boot & Fetch Backend State\n  useEffect(() => {\n    fetch(\'/api/state\')\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.db) {\n          if (data.db.settings) setSettings((prev) => ({ ...prev, ...data.db.settings }));\n          if (data.db.rules) setRules(data.db.rules);\n          if (data.db.rules[0]?.categories) setCategories(data.db.rules[0].categories);\n          if (data.db.activityLog) setActivityLog(data.db.activityLog);\n        }\n        if (data.watchDir) setWatchPath(data.watchDir);\n        if (data.shelfDir) setShelfPath(data.shelfDir);\n        setHasGeminiKey(!!data.hasGeminiKey);\n\n        testOllamaConnection(data.db?.settings?.endpoint || \'http://localhost:11434\');\n        fetchWatchFiles();\n        fetchShelfData();\n      })\n      .catch((err) => {\n        console.error(\'Failed to load initial state:\', err);\n        testOllamaConnection(\'http://localhost:11434\');\n      });\n  }, []);\n\n  // Fetch files in watch directory from backend\n  const fetchWatchFiles = () => {\n    fetch(\'/api/fs/watch-files\')\n      .then((res) => res.json())\n      .then((data) => {\n        if (Array.isArray(data.files)) {\n          const loaded: SortingFile[] = data.files.map((f: any) => ({\n            id: `file-${Date.now()}-${Math.random().toString(36).substring(2, 6)}`,\n            name: f.name,\n            path: f.path,\n            ext: f.ext,\n            size: f.size,\n            sampleContent: f.sampleContent,\n            addedAt: f.mtime || Date.now(),\n            status: \'queued\',\n          }));\n          if (loaded.length > 0) {\n            setFiles((prev) => {\n              const existingNames = new Set(prev.map((p) => p.name));\n              const newFiles = loaded.filter((l) => !existingNames.has(l.name));\n              return [...prev, ...newFiles];\n            });\n          }\n        }\n      })\n      .catch((err) => console.error(\'Watch files error:\', err));\n  };\n\n  // Fetch shelf categories files from backend\n  const fetchShelfData = () => {\n    fetch(\'/api/fs/shelf\')\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.shelf) {\n          setShelfData(data.shelf);\n        }\n      })\n      .catch((err) => console.error(\'Shelf data error:\', err));\n  };\n\n  // Test Ollama Connection\n  const testOllamaConnection = async (endpointUrl?: string) => {\n    const ep = endpointUrl || settings.endpoint;\n    addConsoleLog(`Probing Ollama connection at ${ep}\342\200\246`, \'sys\');\n\n    const t0 = performance.now();\n    try {\n      const resp = await fetch(`/api/ollama/proxy?path=/api/tags`);\n      const latencyMs = Math.round(performance.now() - t0);\n\n      if (!resp.ok) throw new Error(`HTTP ${resp.status}`);\n      const data = await resp.json();\n\n      const available = (data.models || []).map((m: any) => m.name);\n      const modelList = available.length ? available : DEFAULT_MODELS;\n\n      setModels(modelList);\n      if (!modelList.includes(selectedModel)) {\n        setSelectedModel(modelList[0] || \'llama3.2\');\n      }\n\n      setOllamaStatus({\n        connected: true,\n        latencyMs,\n        availableModels: modelList,\n      });\n\n      addConsoleLog(\n        `\342\234\223 Ollama online \302\267 ${modelList.length} model(s) available \302\267 ${latencyMs}ms latency`,\n        \'ok\'\n      );\n    } catch (e: any) {\n      setOllamaStatus({\n        connected: false,\n        latencyMs: null,\n        availableModels: DEFAULT_MODELS,\n      });\n\n      addConsoleLog(\n        `\342\232\240 Ollama unreachable \342\200\224 armed local Heuristic & Gemini AI fallbacks`,\n        \'err\'\n      );\n    }\n  };\n\n  // Real-time File Processing Loop\n  useEffect(() => {\n    const processLoop = setInterval(() => {\n      if (!watching) return;\n\n      const queuedFile = files.find((f) => f.status === \'queued\');\n      if (queuedFile) {\n        processSingleFile(queuedFile);\n      }\n    }, 1500);\n\n    return () => clearInterval(processLoop);\n  }, [files, watching, mode, settings, ollamaStatus, hasGeminiKey, categories]);\n\n  // Classification Pipeline for a file\n  const processSingleFile = async (file: SortingFile) => {\n    // Set file status to analyzing\n    setFiles((prev) =>\n      prev.map((f) => (f.id === file.id ? { ...f, status: \'analyzing\' } : f))\n    );\n\n    addConsoleLog(`\342\206\222 ${file.name} (${fmtSize(file.size)}) \302\267 sniffing file content & metadata\342\200\246`, \'sys\');\n\n    const t0 = performance.now();\n    let decision: Decision | null = null;\n\n    // 1. Try Ollama if connected\n    if (settings.useOllama && ollamaStatus.connected) {\n      try {\n        const sysPrompt = settings.promptTemplate.replace(\n          \'{categories}\',\n          categories.map((c) => `- ${c.name}: ${c.desc || c.exts}`).join(\'\\n\')\n        );\n\n        const resp = await fetch(\'/api/ollama/proxy?path=/api/chat\', {\n          method: \'POST\',\n          headers: { \'Content-Type\': \'application/json\' },\n          body: JSON.stringify({\n            model: selectedModel,\n            stream: false,\n            format: \'json\',\n            options: { temperature: settings.temperature },\n            messages: [\n              { role: \'system\', content: sysPrompt },\n              { role: \'user\', content: `File: ${file.name}\\nExt: ${file.ext}\\nSize: ${fmtSize(file.size)}` },\n            ],\n          }),\n        });\n\n        if (resp.ok) {\n          const data = await resp.json();\n          const raw = (data.message?.content || \'{}\').replace(/```json|```/g, \'\').trim();\n          const parsed = JSON.parse(raw);\n\n          const matchedCat =\n            categories.find((c) => c.name.toLowerCase() === String(parsed.category || \'\').toLowerCase()) ||\n            categories.find((c) => String(parsed.category || \'\').toLowerCase().includes(c.name.toLowerCase())) ||\n            categories[categories.length - 1];\n\n          decision = {\n            catId: matchedCat.id,\n            categoryName: matchedCat.name,\n            confidence: typeof parsed.confidence === \'number\' ? parsed.confidence : 0.88,\n            reason: String(parsed.reason || \'Analyzed via Ollama model\').slice(0, 120),\n            engine: \'ollama\',\n            tokens: data.eval_count || 42,\n            ms: Math.round(performance.now() - t0),\n          };\n        }\n      } catch (err) {\n        addConsoleLog(`Ollama call error, checking fallbacks\342\200\246`, \'err\');\n      }\n    }\n\n    // 2. Try Gemini Fallback if Ollama missed\n    if (!decision && settings.useGeminiFallback && hasGeminiKey) {\n      try {\n        const resp = await fetch(\'/api/gemini/classify\', {\n          method: \'POST\',\n          headers: { \'Content-Type\': \'application/json\' },\n          body: JSON.stringify({\n            fileName: file.name,\n            fileContent: file.sampleContent || \'\',\n            fileExt: file.ext,\n            fileSize: file.size,\n            categories,\n            promptTemplate: settings.promptTemplate,\n          }),\n        });\n\n        if (resp.ok) {\n          const data = await resp.json();\n          const matchedCat =\n            categories.find((c) => c.name.toLowerCase() === String(data.category || \'\').toLowerCase()) ||\n            categories[categories.length - 1];\n\n          decision = {\n            catId: matchedCat.id,\n            categoryName: matchedCat.name,\n            confidence: data.confidence || 0.9,\n            reason: data.reason || \'Analyzed via Gemini 2.5 Flash\',\n            engine: \'gemini\',\n            tokens: data.tokens || 50,\n            ms: Math.round(performance.now() - t0),\n          };\n        }\n      } catch (err) {\n        console.error(\'Gemini fallback error:\', err);\n      }\n    }\n\n    // 3. Heuristic Fallback\n    if (!decision) {\n      const heur = heuristicClassify(file.name, file.ext, categories);\n      decision = {\n        ...heur,\n        ms: Math.round(performance.now() - t0),\n      };\n    }\n\n    // Update File Decision & Log\n    const finalDecision = decision;\n    const catObj = categories.find((c) => c.id === finalDecision.catId) || categories[categories.length - 1];\n\n    addConsoleLog(\n      `<span class=\"tag\">[${finalDecision.engine.toUpperCase()}]</span> <b>${file.name}</b> \342\236\224 <span style=\"color:${catObj.color};font-weight:bold\">${catObj.name}</span> (${Math.round(finalDecision.confidence * 100)}%) \342\200\224 ${finalDecision.reason}`,\n      finalDecision.engine === \'ollama\' ? \'oll\' : finalDecision.engine === \'gemini\' ? \'ok\' : \'heur\'\n    );\n\n    setRecentDecisions((prev) => [\n      { id: `${Date.now()}`, name: file.name, catName: catObj.name, color: catObj.color, t: nowT().slice(0, 5) },\n      ...prev.slice(0, 9),\n    ]);\n\n    setHistMs((prev) => [...prev.slice(-20), finalDecision.ms]);\n    setTotals((prev) => ({ ...prev, tokens: prev.tokens + finalDecision.tokens }));\n\n    setFiles((prev) =>\n      prev.map((f) => {\n        if (f.id === file.id) {\n          return {\n            ...f,\n            decision: finalDecision,\n            status: mode === \'auto\' ? \'decided\' : \'review\',\n          };\n        }\n        return f;\n      })\n    );\n\n    if (mode === \'auto\') {\n      setTimeout(() => {\n        executeSortFile(file.id, finalDecision);\n      }, settings.autoDelay);\n    }\n  };\n\n  // Perform move to shelf\n  const executeSortFile = (fileId: string, decision: Decision) => {\n    const file = files.find((f) => f.id === fileId);\n    if (!file) return;\n\n    fetch(\'/api/fs/move\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify({\n        fileName: file.name,\n        categoryId: decision.catId,\n        engine: decision.engine,\n        confidence: decision.confidence,\n        ms: decision.ms,\n        reason: decision.reason,\n      }),\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        setFiles((prev) => prev.filter((f) => f.id !== fileId));\n        setTotals((prev) => ({ ...prev, sorted: prev.sorted + 1 }));\n\n        const cat = categories.find((c) => c.id === decision.catId) || categories[0];\n\n        const logItem: ActivityLogEntry = {\n          id: `act-${Date.now()}`,\n          t: Date.now(),\n          kind: \'sorted\',\n          file: data.fileName || file.name,\n          cat: cat.name,\n          color: cat.color,\n          engine: decision.engine,\n          conf: decision.confidence,\n          ms: decision.ms,\n          note: decision.reason,\n        };\n\n        setActivityLog((prev) => [logItem, ...prev]);\n        fetchShelfData();\n      })\n      .catch((err) => {\n        console.error(\'Sort move failed:\', err);\n      });\n  };\n\n  const handleApproveFile = (file: SortingFile) => {\n    if (file.decision) {\n      executeSortFile(file.id, file.decision);\n    }\n  };\n\n  const handleSkipFile = (file: SortingFile) => {\n    setFiles((prev) => prev.filter((f) => f.id !== file.id));\n    addConsoleLog(`\342\206\267 ${file.name} skipped by user`, \'sys\');\n\n    setActivityLog((prev) => [\n      {\n        id: `act-${Date.now()}`,\n        t: Date.now(),\n        kind: \'skipped\',\n        file: file.name,\n        note: \'Left in source folder by user review\',\n      },\n      ...prev,\n    ]);\n  };\n\n  // Simulate File Arrival\n  const handleSimulateFile = () => {\n    const pool = [\n      \'Q3-Financial-Report-2026.pdf\',\n      \'invoice_ACME_0042.pdf\',\n      \'IMG_2026_0725.heic\',\n      \'screenshot-2026.png\',\n      \'tax-returns-final.docx\',\n      \'podcast-ep-42.mp3\',\n      \'backup-app-data.zip\',\n      \'customer-analytics-q2.csv\',\n      \'landing-page-component.tsx\',\n      \'server-main.py\',\n      \'resume-candidate.pdf\',\n      \'meeting-notes-july.md\',\n      \'demo-reel-4k.mov\',\n      \'logo-vector-brand.fig\',\n      \'dataset-metrics.json\',\n    ];\n\n    const randomName = pool[Math.floor(Math.random() * pool.length)];\n\n    fetch(\'/api/fs/create-simulated\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify({\n        fileName: randomName,\n        content: `Simulated document contents for ${randomName} created at ${new Date().toISOString()}`,\n      }),\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (data.file) {\n          const newFile: SortingFile = {\n            id: `file-${Date.now()}-${Math.random().toString(36).substring(2, 6)}`,\n            name: data.file.name,\n            path: data.file.path,\n            ext: data.file.ext,\n            size: data.file.size,\n            sampleContent: `Simulated content excerpt for ${data.file.name}`,\n            addedAt: Date.now(),\n            status: \'queued\',\n          };\n\n          setFiles((prev) => [...prev, newFile]);\n          addConsoleLog(`\357\274\213 Simulated file arrival: ${newFile.name}`, \'sys\');\n        }\n      })\n      .catch((err) => console.error(\'Simulate error:\', err));\n  };\n\n  // File Upload Handler\n  const handleUploadFiles = (fileList: FileList | File[]) => {\n    const formData = new FormData();\n    Array.from(fileList).forEach((f) => formData.append(\'files\', f));\n\n    fetch(\'/api/fs/upload\', {\n      method: \'POST\',\n      body: formData,\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        if (Array.isArray(data.files)) {\n          fetchWatchFiles();\n          addConsoleLog(`\342\206\221 Uploaded ${data.files.length} file(s) to Watch folder`, \'ok\');\n        }\n      })\n      .catch((err) => console.error(\'Upload error:\', err));\n  };\n\n  // Undo move\n  const handleUndoMove = (fileName: string) => {\n    fetch(\'/api/fs/undo\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        addConsoleLog(`\342\206\266 Restored ${data.undoneCount} file(s) back to Watch folder`, \'ok\');\n        fetchWatchFiles();\n        fetchShelfData();\n      })\n      .catch((err) => console.error(\'Undo error:\', err));\n  };\n\n  // Bulk Undo\n  const handleBulkUndo = () => {\n    fetch(\'/api/fs/undo\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify({ bulk: true }),\n    })\n      .then((res) => res.json())\n      .then((data) => {\n        addConsoleLog(`\342\206\266 Bulk undone ${data.undoneCount} file move(s)`, \'ok\');\n        fetchWatchFiles();\n        fetchShelfData();\n      })\n      .catch((err) => console.error(\'Bulk undo error:\', err));\n  };\n\n  // Update Settings\n  const handleUpdateSettings = (newSettings: Settings) => {\n    setSettings(newSettings);\n    fetch(\'/api/settings\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify(newSettings),\n    });\n  };\n\n  // Update Rules\n  const handleUpdateRules = (newRules: Rule[]) => {\n    setRules(newRules);\n    if (newRules[0]?.categories) {\n      setCategories(newRules[0].categories);\n    }\n    fetch(\'/api/rules\', {\n      method: \'POST\',\n      headers: { \'Content-Type\': \'application/json\' },\n      body: JSON.stringify(newRules),\n    });\n  };\n\n  // Drag & Drop handlers on window\n  const handleDragOver = (e: React.DragEvent) => {\n    e.preventDefault();\n    setIsDropOver(true);\n  };\n\n  const handleDragLeave = () => {\n    setIsDropOver(false);\n  };\n\n  const handleDrop = (e: React.DragEvent) => {\n    e.preventDefault();\n    setIsDropOver(false);\n    if (e.dataTransfer.files && e.dataTransfer.files.length > 0) {\n      handleUploadFiles(e.dataTransfer.files);\n    }\n  };\n\n  return (\n    <div\n      onDragOver={handleDragOver}\n      onDragLeave={handleDragLeave}\n      onDrop={handleDrop}\n      className=\"min-h-screen bg-[#0c1410] text-[#211f19] flex items-center justify-center p-2 sm:p-4 font-sans select-none relative\"\n    >\n      {/* Hidden File Input for Upload */}\n      <input\n        type=\"file\"\n        multiple\n        ref={fileInputRef}\n        onChange={(e) => e.target.files && handleUploadFiles(e.target.files)}\n        className=\"hidden\"\n      />\n\n      {/* Main Desktop Window Container */}\n      <div className=\"w-full max-w-[1280px] h-[90vh] min-h-[620px] bg-[#f6f4ee] rounded-2xl border border-black/30 shadow-2xl overflow-hidden flex flex-col relative z-10\">\n        {/* Top Desktop Chrome Toolbar */}\n        <TopBar\n          platform={platform}\n          setPlatform={setPlatform}\n          watching={watching}\n          onToggleWatch={() => setWatching(!watching)}\n          watchPath={watchPath}\n          onEditPath={() => setPermissionModal({ isOpen: true, path: watchPath })}\n          models={models}\n          selectedModel={selectedModel}\n          onSelectModel={setSelectedModel}\n          mode={mode}\n          onSetMode={setMode}\n          onSimulate={handleSimulateFile}\n          onUploadClick={() => fileInputRef.current?.click()}\n          engineOnline={ollamaStatus.connected}\n          engineName={selectedModel}\n          hasGeminiKey={hasGeminiKey}\n        />\n\n        {/* Main Body */}\n        <div className=\"flex-1 flex min-h-0 bg-[#f6f4ee]\">\n          {/* Sidebar Navigation */}\n          <Sidebar\n            activeTab={activeTab}\n            setActiveTab={setActiveTab}\n            queueLength={files.length}\n            ollamaStatus={ollamaStatus}\n            onTestOllama={() => testOllamaConnection()}\n          />\n\n          {/* Tab Views Content */}\n          <main className=\"flex-1 min-w-0 bg-[#f6f4ee] overflow-hidden relative\">\n            {activeTab === \'watch\' && (\n              <WatchView\n                files={files}\n                categories={categories}\n                mode={mode}\n                onApproveFile={handleApproveFile}\n                onSkipFile={handleSkipFile}\n                totals={totals}\n                histMs={histMs}\n                consoleLogs={consoleLogs}\n                onClearConsole={() => setConsoleLogs([])}\n                recentDecisions={recentDecisions}\n                watching={watching}\n                watchPath={watchPath}\n              />\n            )}\n\n            {activeTab === \'shelf\' && (\n              <ShelfView\n                categories={categories}\n                shelfData={shelfData}\n                selectedCatId={selectedCatId}\n                onSelectCategory={setSelectedCatId}\n                onUndoSortFile={handleUndoMove}\n                shelfDirPath={shelfPath}\n              />\n            )}\n\n            {activeTab === \'rules\' && (\n              <RulesView\n                rules={rules}\n                onUpdateRules={handleUpdateRules}\n                promptTemplate={settings.promptTemplate}\n                onUpdatePromptTemplate={(tpl) =>\n                  handleUpdateSettings({ ...settings, promptTemplate: tpl })\n                }\n                onResetRules={() => {\n                  setCategories(DEFAULT_CATEGORIES);\n                  if (rules[0]) {\n                    handleUpdateRules([{ ...rules[0], categories: DEFAULT_CATEGORIES }]);\n                  }\n                }}\n              />\n            )}\n\n            {activeTab === \'activity\' && (\n              <ActivityView\n                logs={activityLog}\n                onClearLogs={() => {\n                  setActivityLog([]);\n                  fetch(\'/api/activity/clear\', { method: \'POST\' });\n                }}\n                onUndoMove={handleUndoMove}\n                onBulkUndo={handleBulkUndo}\n              />\n            )}\n\n            {activeTab === \'settings\' && (\n              <SettingsView\n                settings={settings}\n                onUpdateSettings={handleUpdateSettings}\n                onTestOllama={() => testOllamaConnection()}\n                hasGeminiKey={hasGeminiKey}\n                platform={platform}\n                permissions={[\n                  { path: watchPath, platform, granted: true, scope: \'watch-folder\' },\n                  { path: shelfPath, platform, granted: true, scope: \'shelf-folder\' },\n                ]}\n                onRequestPermission={(p) => setPermissionModal({ isOpen: true, path: p })}\n                onResetAll={() => {\n                  localStorage.clear();\n                  window.location.reload();\n                }}\n              />\n            )}\n          </main>\n        </div>\n\n        {/* Footer Statusbar */}\n        <footer className=\"h-7 bg-[#efede4] border-t border-[#dcd8c9] px-4 flex items-center justify-between text-[11px] font-mono text-[#5c584c]\">\n          <div className=\"flex items-center gap-2\">\n            <span\n              className={`w-2 h-2 rounded-full ${\n                watching ? \'bg-emerald-500 animate-pulse\' : \'bg-gray-400\'\n              }`}\n            />\n            <span>{watching ? `Watching ${watchPath}` : \'Paused\'}</span>\n          </div>\n\n          <div className=\"hidden sm:block text-[#8b8676]\">\n            drop files anywhere to sort them \302\267 <kbd className=\"bg-white border px-1 rounded\">S</kbd> simulate file\n          </div>\n\n          <div>\n            engine: <b>{ollamaStatus.connected ? `ollama (${selectedModel})` : hasGeminiKey ? \'gemini fallback\' : \'heuristic\'}</b>\n          </div>\n        </footer>\n      </div>\n\n      {/* Drag & Drop Visual Overlay */}\n      {isDropOver && (\n        <div className=\"fixed inset-0 bg-black/70 backdrop-blur-sm z-50 flex items-center justify-center pointer-events-none\">\n          <div className=\"border-4 border-dashed border-emerald-400 rounded-3xl p-12 text-center text-white font-sans max-w-lg\">\n            <div className=\"text-4xl mb-3\">\360\237\223\245</div>\n            <h2 className=\"font-display font-extrabold text-2xl\">\n              Release to Drop into Watch Folder\n            </h2>\n            <p className=\"text-xs font-mono text-emerald-200 mt-2\">\n              Sift will read filenames & metadata and sort them via AI\n            </p>\n          </div>\n        </div>\n      )}\n\n      {/* Permission Request Modal */}\n      <PermissionModal\n        isOpen={permissionModal.isOpen}\n        path={permissionModal.path}\n        platform={platform}\n        onGrant={() => setPermissionModal({ isOpen: false, path: \'\' })}\n        onCancel={() => setPermissionModal({ isOpen: false, path: \'\' })}\n      />\n    </div>\n  );\n}\n"
    }
