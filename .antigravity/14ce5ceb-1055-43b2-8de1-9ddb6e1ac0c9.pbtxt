    instruction: "Remove Gemini fallback from processSingleFile and update logs in App.tsx"
    replacement_infos {
      original_chunk {
        target_content: "      addConsoleLog(\n        `\342\232\240 Ollama unreachable \342\200\224 armed local Heuristic & Gemini AI fallbacks`,\n        \'err\'\n      );\n    }\n  };\n\n  // Real-time File Processing Loop\n  useEffect(() => {\n    const processLoop = setInterval(() => {\n      if (!watching) return;\n\n      const queuedFile = files.find((f) => f.status === \'queued\');\n      if (queuedFile) {\n        processSingleFile(queuedFile);\n      }\n    }, 1500);\n\n    return () => clearInterval(processLoop);\n  }, [files, watching, mode, settings, ollamaStatus, hasGeminiKey, categories]);\n\n  // Classification Pipeline for a file\n  const processSingleFile = async (file: SortingFile) => {\n    // Set file status to analyzing\n    setFiles((prev) =>\n      prev.map((f) => (f.id === file.id ? { ...f, status: \'analyzing\' } : f))\n    );\n\n    addConsoleLog(`\342\206\222 ${file.name} (${fmtSize(file.size)}) \302\267 sniffing file content & metadata\342\200\246`, \'sys\');\n\n    const t0 = performance.now();\n    let decision: Decision | null = null;\n\n    // 1. Try Ollama if connected\n    if (settings.useOllama && ollamaStatus.connected) {\n      try {\n        const sysPrompt = settings.promptTemplate.replace(\n          \'{categories}\',\n          categories.map((c) => `- ${c.name}: ${c.desc || c.exts}`).join(\'\\n\')\n        );\n\n        const resp = await fetch(\'/api/ollama/proxy?path=/api/chat\', {\n          method: \'POST\',\n          headers: { \'Content-Type\': \'application/json\' },\n          body: JSON.stringify({\n            model: selectedModel,\n            stream: false,\n            format: \'json\',\n            options: { temperature: settings.temperature },\n            messages: [\n              { role: \'system\', content: sysPrompt },\n              { role: \'user\', content: `File: ${file.name}\\nExt: ${file.ext}\\nSize: ${fmtSize(file.size)}` },\n            ],\n          }),\n        });\n\n        if (resp.ok) {\n          const data = await resp.json();\n          const raw = (data.message?.content || \'{}\').replace(/```json|```/g, \'\').trim();\n          const parsed = JSON.parse(raw);\n\n          const matchedCat =\n            categories.find((c) => c.name.toLowerCase() === String(parsed.category || \'\').toLowerCase()) ||\n            categories.find((c) => String(parsed.category || \'\').toLowerCase().includes(c.name.toLowerCase())) ||\n            categories[categories.length - 1];\n\n          decision = {\n            catId: matchedCat.id,\n            categoryName: matchedCat.name,\n            confidence: typeof parsed.confidence === \'number\' ? parsed.confidence : 0.88,\n            reason: String(parsed.reason || \'Analyzed via Ollama model\').slice(0, 120),\n            engine: \'ollama\',\n            tokens: data.eval_count || 42,\n            ms: Math.round(performance.now() - t0),\n          };\n        }\n      } catch (err) {\n        addConsoleLog(`Ollama call error, checking fallbacks\342\200\246`, \'err\');\n      }\n    }\n\n    // 2. Try Gemini Fallback if Ollama missed\n    if (!decision && settings.useGeminiFallback && hasGeminiKey) {\n      try {\n        const resp = await fetch(\'/api/gemini/classify\', {\n          method: \'POST\',\n          headers: { \'Content-Type\': \'application/json\' },\n          body: JSON.stringify({\n            fileName: file.name,\n            fileContent: file.sampleContent || \'\',\n            fileExt: file.ext,\n            fileSize: file.size,\n            categories,\n            promptTemplate: settings.promptTemplate,\n          }),\n        });\n\n        if (resp.ok) {\n          const data = await resp.json();\n          const matchedCat =\n            categories.find((c) => c.name.toLowerCase() === String(data.category || \'\').toLowerCase()) ||\n            categories[categories.length - 1];\n\n          decision = {\n            catId: matchedCat.id,\n            categoryName: matchedCat.name,\n            confidence: data.confidence || 0.9,\n            reason: data.reason || \'Analyzed via Gemini 2.5 Flash\',\n            engine: \'gemini\',\n            tokens: data.tokens || 50,\n            ms: Math.round(performance.now() - t0),\n          };\n        }\n      } catch (err) {\n        console.error(\'Gemini fallback error:\', err);\n      }\n    }\n\n    // 3. Heuristic Fallback\n    if (!decision) {\n      const heur = heuristicClassify(file.name, file.ext, categories);\n      decision = {\n        ...heur,\n        ms: Math.round(performance.now() - t0),\n      };\n    }\n\n    // Update File Decision & Log\n    const finalDecision = decision;\n    const catObj = categories.find((c) => c.id === finalDecision.catId) || categories[categories.length - 1];\n\n    addConsoleLog(\n      `<span class=\"tag\">[${finalDecision.engine.toUpperCase()}]</span> <b>${file.name}</b> \342\236\224 <span style=\"color:${catObj.color};font-weight:bold\">${catObj.name}</span> (${Math.round(finalDecision.confidence * 100)}%) \342\200\224 ${finalDecision.reason}`,\n      finalDecision.engine === \'ollama\' ? \'oll\' : finalDecision.engine === \'gemini\' ? \'ok\' : \'heur\'\n    );"
        replacement_content: "      addConsoleLog(\n        `\342\232\240 Ollama unreachable \342\200\224 using local Heuristics engine`,\n        \'err\'\n      );\n    }\n  };\n\n  // Real-time File Processing Loop\n  useEffect(() => {\n    const processLoop = setInterval(() => {\n      if (!watching) return;\n\n      const queuedFile = files.find((f) => f.status === \'queued\');\n      if (queuedFile) {\n        processSingleFile(queuedFile);\n      }\n    }, 1500);\n\n    return () => clearInterval(processLoop);\n  }, [files, watching, mode, settings, ollamaStatus, categories]);\n\n  // Classification Pipeline for a file\n  const processSingleFile = async (file: SortingFile) => {\n    // Set file status to analyzing\n    setFiles((prev) =>\n      prev.map((f) => (f.id === file.id ? { ...f, status: \'analyzing\' } : f))\n    );\n\n    addConsoleLog(`\342\206\222 ${file.name} (${fmtSize(file.size)}) \302\267 sniffing file content & metadata\342\200\246`, \'sys\');\n\n    const t0 = performance.now();\n    let decision: Decision | null = null;\n\n    // 1. Try Ollama if connected\n    if (settings.useOllama && ollamaStatus.connected) {\n      try {\n        const sysPrompt = settings.promptTemplate.replace(\n          \'{categories}\',\n          categories.map((c) => `- ${c.name}: ${c.desc || c.exts}`).join(\'\\n\')\n        );\n\n        const resp = await fetch(\'/api/ollama/proxy?path=/api/chat\', {\n          method: \'POST\',\n          headers: { \'Content-Type\': \'application/json\' },\n          body: JSON.stringify({\n            model: selectedModel,\n            stream: false,\n            format: \'json\',\n            options: { temperature: settings.temperature },\n            messages: [\n              { role: \'system\', content: sysPrompt },\n              { role: \'user\', content: `File: ${file.name}\\nExt: ${file.ext}\\nSize: ${fmtSize(file.size)}` },\n            ],\n          }),\n        });\n\n        if (resp.ok) {\n          const data = await resp.json();\n          const raw = (data.message?.content || \'{}\').replace(/```json|```/g, \'\').trim();\n          const parsed = JSON.parse(raw);\n\n          const matchedCat =\n            categories.find((c) => c.name.toLowerCase() === String(parsed.category || \'\').toLowerCase()) ||\n            categories.find((c) => String(parsed.category || \'\').toLowerCase().includes(c.name.toLowerCase())) ||\n            categories[categories.length - 1];\n\n          decision = {\n            catId: matchedCat.id,\n            categoryName: matchedCat.name,\n            confidence: typeof parsed.confidence === \'number\' ? parsed.confidence : 0.88,\n            reason: String(parsed.reason || \'Analyzed via Ollama model\').slice(0, 120),\n            engine: \'ollama\',\n            tokens: data.eval_count || 42,\n            ms: Math.round(performance.now() - t0),\n          };\n        }\n      } catch (err) {\n        addConsoleLog(`Ollama call error, using local heuristic fallback\342\200\246`, \'err\');\n      }\n    }\n\n    // 2. Heuristic Fallback\n    if (!decision) {\n      const heur = heuristicClassify(file.name, file.ext, categories);\n      decision = {\n        ...heur,\n        ms: Math.round(performance.now() - t0),\n      };\n    }\n\n    // Update File Decision & Log\n    const finalDecision = decision;\n    const catObj = categories.find((c) => c.id === finalDecision.catId) || categories[categories.length - 1];\n\n    addConsoleLog(\n      `<span class=\"tag\">[${finalDecision.engine.toUpperCase()}]</span> <b>${file.name}</b> \342\236\224 <span style=\"color:${catObj.color};font-weight:bold\">${catObj.name}</span> (${Math.round(finalDecision.confidence * 100)}%) \342\200\224 ${finalDecision.reason}`,\n      finalDecision.engine === \'ollama\' ? \'oll\' : \'heur\'\n    );"
